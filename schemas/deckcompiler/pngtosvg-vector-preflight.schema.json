{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/pngtosvg-vector-preflight.schema.json",
  "title": "Measured PNG-to-SVG Vector Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "workflow_id",
    "policy_id",
    "status",
    "engine_role",
    "canonical_renderer",
    "pipeline_provenance",
    "execution",
    "quality_contract",
    "source_artifacts",
    "slide_count",
    "measured_region_count",
    "passed_vector_count",
    "slides",
    "content_hash"
  ],
  "properties": {
    "schema_name": {"const": "pngtosvg_vector_preflight"},
    "schema_version": {"const": "1.0.0"},
    "workflow_id": {"type": "string", "pattern": "^generate_[0-9a-f]{20}$"},
    "policy_id": {"const": "raw-measured-bounded-vector-v1"},
    "status": {"const": "READY"},
    "engine_role": {"const": "measurement_and_bounded_vector_preflight_only"},
    "canonical_renderer": {"const": "slide-image-dual-render"},
    "pipeline_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "detector", "batch_adapter", "svg_icon_library", "svg_icon_names", "reuse_mode"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "detector": {"$ref": "#/$defs/externalArtifact"},
        "batch_adapter": {"$ref": "#/$defs/externalArtifact"},
        "svg_icon_library": {
          "oneOf": [
            {"$ref": "#/$defs/externalArtifact"},
            {"type": "null"}
          ]
        },
        "svg_icon_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reuse_mode": {"const": "external_measurement_engine_no_repo_local_fork"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "python_executable", "canvas", "deep_text", "deep_scan", "max_parallel_measurement_workers", "ocr_reader_initializations_maximum", "measurement_dispatch", "additional_model_calls"],
      "properties": {
        "backend": {"enum": ["easyocr", "tesseract"]},
        "python_executable": {"type": "string", "minLength": 3},
        "canvas": {"const": "native"},
        "deep_text": {"const": true},
        "deep_scan": {"type": "boolean"},
        "max_parallel_measurement_workers": {"type": "integer", "minimum": 1, "maximum": 4},
        "ocr_reader_initializations_maximum": {"type": "integer", "minimum": 1, "maximum": 4},
        "measurement_dispatch": {"const": "bounded_batch_processes_shared_reader_per_worker"},
        "additional_model_calls": {"const": 0}
      }
    },
    "quality_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_coordinates_authoritative",
        "semantic_text_vectorization_forbidden",
        "full_slide_vectorization_forbidden",
        "full_slide_raster_delivery_forbidden",
        "maximum_vector_region_area_ratio",
        "continuous_tone_vectorization_forbidden",
        "svg_security_and_fidelity_gate_required",
        "native_pptx_rebuild_remains_default"
      ],
      "properties": {
        "measured_coordinates_authoritative": {"const": true},
        "semantic_text_vectorization_forbidden": {"const": true},
        "full_slide_vectorization_forbidden": {"const": true},
        "full_slide_raster_delivery_forbidden": {"const": true},
        "maximum_vector_region_area_ratio": {"const": 0.35},
        "continuous_tone_vectorization_forbidden": {"const": true},
        "svg_security_and_fidelity_gate_required": {"const": true},
        "native_pptx_rebuild_remains_default": {"const": true}
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_request_manifest", "image_generation_batch_manifest", "skillset_execution_plan"],
      "properties": {
        "image_request_manifest": {"$ref": "#/$defs/artifact"},
        "image_generation_batch_manifest": {"$ref": "#/$defs/artifact"},
        "skillset_execution_plan": {"$ref": "#/$defs/artifact"}
      }
    },
    "slide_count": {"type": "integer", "minimum": 1},
    "measured_region_count": {"type": "integer", "minimum": 0},
    "passed_vector_count": {"type": "integer", "minimum": 0},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1}
      }
    },
    "normalizedBbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "kind_hint",
        "bbox_px",
        "bbox_norm",
        "area_ratio",
        "semantic_text_overlap_ids",
        "measurement_confidence",
        "disposition",
        "reason"
      ],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "kind_hint": {"type": "string", "minLength": 1},
        "bbox_px": {"$ref": "#/$defs/bbox"},
        "bbox_norm": {"$ref": "#/$defs/normalizedBbox"},
        "area_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "semantic_text_overlap_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "measurement_confidence": {"type": ["number", "null"]},
        "disposition": {
          "enum": [
            "bounded_svg_asset",
            "bounded_raster_candidate",
            "native_rebuild_text_protected",
            "native_rebuild_large_region",
            "native_rebuild_or_skill_review"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "candidate_png": {"$ref": "#/$defs/artifact"},
        "trace_report": {"$ref": "#/$defs/artifact"},
        "vector_svg": {"$ref": "#/$defs/artifact"},
        "vector_preview": {"$ref": "#/$defs/artifact"}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_number",
        "slide_id",
        "request_id",
        "source_png",
        "measurement_inventory",
        "measurement_batch_job",
        "detector_record",
        "text_block_count",
        "regions",
        "slide_content_hash"
      ],
      "properties": {
        "slide_number": {"type": "integer", "minimum": 1},
        "slide_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "source_png": {"$ref": "#/$defs/sourceArtifact"},
        "measurement_inventory": {"$ref": "#/$defs/artifact"},
        "measurement_batch_job": {"$ref": "#/$defs/artifact"},
        "detector_record": {"$ref": "#/$defs/artifact"},
        "text_block_count": {"type": "integer", "minimum": 0},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
        "slide_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
