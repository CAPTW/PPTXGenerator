{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/codex-skillset-execution-plan.schema.json",
  "title": "Codex SkillSet Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "workflow_id",
    "status",
    "skill_root",
    "repository_skill_root",
    "repository_skill_files",
    "ordered_skills",
    "official_entrypoints",
    "qa_calibration_profile",
    "project_layout",
    "environment_template",
    "dependency_contract",
    "vector_preflight_contract",
    "execution_profile",
    "quality_contract",
    "crop_contract",
    "one_slide_fast_contract",
    "command_templates",
    "execution_contract",
    "required_artifacts",
    "stop_conditions",
    "content_hash"
  ],
  "properties": {
    "schema_name": {"const": "codex_skillset_execution_plan"},
    "schema_version": {"const": "1.8.0"},
    "workflow_id": {"type": "string", "pattern": "^generate_[0-9a-f]{20}$"},
    "status": {"const": "READY"},
    "skill_root": {"type": "string", "minLength": 1},
    "repository_skill_root": {
      "type": "string",
      "pattern": "[\\\\/]\\.agents[\\\\/]skills[\\\\/]pptx-workflow-architect$"
    },
    "repository_skill_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "design_system", "large_deck", "production_qa"],
      "properties": {
        "skill": {"$ref": "#/$defs/repositorySkillFile"},
        "design_system": {"$ref": "#/$defs/repositorySkillFile"},
        "large_deck": {"$ref": "#/$defs/repositorySkillFile"},
        "production_qa": {"$ref": "#/$defs/repositorySkillFile"}
      }
    },
    "ordered_skills": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/architectSkill"},
        {"$ref": "#/$defs/imageSkill"},
        {"$ref": "#/$defs/orchestratorSkill"},
        {"$ref": "#/$defs/textLayerSkill"},
        {"$ref": "#/$defs/rendererSkill"},
        {"$ref": "#/$defs/qaSkill"}
      ],
      "items": false
    },
    "official_entrypoints": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/entrypoint"},
      "required": [
        "orchestration_plan",
        "summarize_visual_backlog",
        "make_repair_wave_plan",
        "generate_repair_prompt",
        "enforce_orchestration_state",
        "detect_text_regions",
        "make_text_masks",
        "classify_background_regions",
        "repair_text_backgrounds",
        "detect_residual_text",
        "enforce_text_layer",
        "install_hardlock",
        "crop_generator",
        "slide_pipeline",
        "final_gate",
        "validate_agent_work",
        "integrate_subagent_work",
        "rasterize_pptx",
        "capture_html_screenshot",
        "compare_slide_images",
        "generate_visual_qa_summary",
        "enforce_visual_qa"
      ]
    },
    "qa_calibration_profile": {"$ref": "#/$defs/calibrationProfile"},
    "project_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_root",
        "source_png_pattern",
        "image_batch_manifest_path",
        "image_request_manifest_path",
        "streaming_execution_path",
        "timing_report_path",
        "semantic_sidecar_pattern",
        "per_slide_work_pattern",
        "vector_preflight_manifest_path",
        "measurement_inventory_pattern",
        "bounded_vector_asset_pattern",
        "reconstruction_job_manifest_path",
        "integration_report_path",
        "profile_path",
        "qa_calibration_profile_path",
        "icon_usage_path",
        "icon_cache_manifest_path",
        "background_cache_manifest_path",
        "slides_source_path",
        "crop_plan_path",
        "crop_manifest_path",
        "output_root"
      ],
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "source_png_pattern": {"type": "string", "pattern": "slideN\\.png$"},
        "image_batch_manifest_path": {"type": "string", "pattern": "image_generation_batch_manifest\\.json$"},
        "image_request_manifest_path": {"type": "string", "pattern": "image_request_manifest\\.json$"},
        "streaming_execution_path": {"type": "string", "pattern": "streaming_execution\\.json$"},
        "timing_report_path": {"type": "string", "pattern": "execution_timing\\.json$"},
        "semantic_sidecar_pattern": {"type": "string", "pattern": "slide-NNN\\.semantic\\.json$"},
        "per_slide_work_pattern": {"type": "string", "pattern": "slideXX$"},
        "vector_preflight_manifest_path": {"type": "string", "pattern": "vector_preflight_manifest\\.json$"},
        "measurement_inventory_pattern": {"type": "string", "pattern": "measurement_inventory\\.json$"},
        "bounded_vector_asset_pattern": {"type": "string", "pattern": "RNN\\.svg$"},
        "reconstruction_job_manifest_path": {"type": "string", "pattern": "reconstruction_job_manifest\\.json$"},
        "integration_report_path": {"type": "string", "pattern": "integration_report\\.md$"},
        "profile_path": {"type": "string", "pattern": "active\\.json$"},
        "qa_calibration_profile_path": {"type": "string", "pattern": "default-visual-qa-profile\\.json$"},
        "icon_usage_path": {"type": "string", "pattern": "icon_usage\\.json$"},
        "icon_cache_manifest_path": {"type": "string", "pattern": "icons[\\\\/]manifest\\.json$"},
        "background_cache_manifest_path": {"type": "string", "pattern": "bg\\.manifest\\.json$"},
        "slides_source_path": {"type": "string", "pattern": "slides\\.js$"},
        "crop_plan_path": {"type": "string", "pattern": "crop_plan\\.json$"},
        "crop_manifest_path": {"type": "string", "pattern": "manifest\\.json$"},
        "output_root": {"type": "string", "minLength": 1}
      }
    },
    "environment_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SLIDE_PIPELINE_STRICT", "DECK_PROFILE", "DECK_ASSETS", "DECK_ICON_USAGE", "DECK_ICON_WORKERS", "VISUAL_QA_PROFILE", "DECK_PXW", "DECK_PXH", "CROP_PLAN", "SRC_DIR", "WORK_DIR", "SLIDES_OUT", "CROP_PLAN_OUT", "INTEGRATION_REPORT_OUT"],
      "properties": {
        "SLIDE_PIPELINE_STRICT": {"const": "1"},
        "DECK_PROFILE": {"type": "string", "minLength": 1},
        "DECK_ASSETS": {"type": "string", "minLength": 1},
        "DECK_ICON_USAGE": {"type": "string", "pattern": "icon_usage\\.json$"},
        "DECK_ICON_WORKERS": {"const": "16"},
        "VISUAL_QA_PROFILE": {"type": "string", "pattern": "default-visual-qa-profile\\.json$"},
        "DECK_PXW": {"const": "<source-width>"},
        "DECK_PXH": {"const": "<source-height>"},
        "CROP_PLAN": {"type": "string", "pattern": "crop_plan\\.json$"},
        "SRC_DIR": {"type": "string", "minLength": 1},
        "WORK_DIR": {"type": "string", "pattern": "work$"},
        "SLIDES_OUT": {"type": "string", "pattern": "slides\\.js$"},
        "CROP_PLAN_OUT": {"type": "string", "pattern": "crop_plan\\.json$"},
        "INTEGRATION_REPORT_OUT": {"type": "string", "pattern": "integration_report\\.md$"}
      }
    },
    "dependency_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_packages", "resolution_order", "hidden_node_path_forbidden"],
      "properties": {
        "node_packages": {
          "type": "array",
          "prefixItems": [
            {"const": "pptxgenjs"},
            {"const": "sharp"},
            {"const": "react"},
            {"const": "react-dom"},
            {"const": "react-icons"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "resolution_order": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "hidden_node_path_forbidden": {"const": true}
      }
    },
    "vector_preflight_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pipeline",
        "resolution_order",
        "python_resolution_order",
        "reuse_mode",
        "measurement_command",
        "ocr_reader_lifecycle",
        "deep_runtime_requirements",
        "max_parallel_measurement_workers",
        "additional_model_calls",
        "maximum_vector_region_area_ratio",
        "semantic_text_vectorization_forbidden",
        "continuous_tone_vectorization_forbidden",
        "full_slide_vectorization_forbidden",
        "svg_security_and_fidelity_gate_required",
        "canonical_renderer_unchanged"
      ],
      "properties": {
        "source_pipeline": {"const": "PPTXlocal/raw/pipeline"},
        "resolution_order": {
          "const": [
            "--pipeline-root",
            "PPTXLOCAL_RAW_PNGTOSVG_ROOT",
            "repository ancestor auto-discovery"
          ]
        },
        "python_resolution_order": {
          "const": [
            "--python-executable",
            "PPTXLOCAL_RAW_PYTHON",
            "deckcompiler interpreter"
          ]
        },
        "reuse_mode": {"const": "external_measurement_engine_no_repo_local_fork"},
        "measurement_command": {"const": "raw_measure_batch.py -> detect_elements.build_inventory(canvas=native, deep_text=True) + deep_scan"},
        "ocr_reader_lifecycle": {"const": "one_shared_reader_per_batch_worker"},
        "deep_runtime_requirements": {
          "const": [
            "pytesseract",
            "tesseract executable",
            "eng language pack",
            "kor language pack"
          ]
        },
        "max_parallel_measurement_workers": {"const": 2},
        "additional_model_calls": {"const": 0},
        "maximum_vector_region_area_ratio": {"const": 0.35},
        "semantic_text_vectorization_forbidden": {"const": true},
        "continuous_tone_vectorization_forbidden": {"const": true},
        "full_slide_vectorization_forbidden": {"const": true},
        "svg_security_and_fidelity_gate_required": {"const": true},
        "canonical_renderer_unchanged": {"const": "slide-image-dual-render"}
      }
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_name",
        "target_model",
        "target_reasoning_effort",
        "max_imagegen_parallel_slides",
        "max_reconstruction_workers",
        "fallback_policy",
        "determinism_contract",
        "worker_context",
        "default_design_direction",
        "prompt_policy",
        "image_generation",
        "reconstruction_authoring",
        "compilation",
        "performance_target"
      ],
      "properties": {
        "profile_name": {"enum": ["terra-max", "sol-medium", "luna-max"]},
        "target_model": {"enum": ["gpt-5.6-terra", "gpt-5.6-sol", "gpt-5.6-luna"]},
        "target_reasoning_effort": {"enum": ["medium", "max"]},
        "max_imagegen_parallel_slides": {"const": 20},
        "max_reconstruction_workers": {"const": 6},
        "fallback_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_name", "scope", "max_attempts", "triggers", "quality_gate_bypass_forbidden"],
          "properties": {
            "profile_name": {"enum": [null, "sol-medium"]},
            "scope": {"const": "failed_slide_only"},
            "max_attempts": {"enum": [0, 1]},
            "triggers": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["authoring_contract_failure", "reconstruction_hardlock_failure", "visual_qa_blocking"]}
            },
            "quality_gate_bypass_forbidden": {"const": true}
          }
        },
        "determinism_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architect_blueprint_shared", "image_prompts_shared", "semantic_sidecars_shared", "renderer_contract_shared", "vector_policy_id", "compiler_and_qa_shared"],
          "properties": {
            "architect_blueprint_shared": {"const": true},
            "image_prompts_shared": {"const": true},
            "semantic_sidecars_shared": {"const": true},
            "renderer_contract_shared": {"const": true},
            "vector_policy_id": {"const": "raw-measured-bounded-vector-v1"},
            "compiler_and_qa_shared": {"const": true}
          }
        },
        "worker_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "codex_argv", "sealed_single_slide_job_only", "full_skill_catalog_forbidden", "explicit_renderer_skill_path_required"],
          "properties": {
            "mode": {"const": "minimal_locked"},
            "codex_argv": {
              "const": ["--ephemeral", "--ignore-user-config", "--ignore-rules", "--disable", "plugins", "--disable", "apps", "--disable", "memories", "--disable", "multi_agent", "--disable", "image_generation"]
            },
            "sealed_single_slide_job_only": {"const": true},
            "full_skill_catalog_forbidden": {"const": true},
            "explicit_renderer_skill_path_required": {"const": true}
          }
        },
        "default_design_direction": {
          "const": ["Academic", "Informative", "Professional", "Creative"]
        },
        "prompt_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preserve_user_direction", "blanket_layout_bans_forbidden", "hard_numeric_density_caps_forbidden", "preparation_mode", "preparation_command", "additional_model_call_required", "architect_lineage_required"],
          "properties": {
            "mode": {"const": "concise_content_adaptive"},
            "preserve_user_direction": {"const": true},
            "blanket_layout_bans_forbidden": {"const": true},
            "hard_numeric_density_caps_forbidden": {"const": true},
            "preparation_mode": {"const": "single_deterministic_pass"},
            "preparation_command": {"const": "deckcompiler prepare-image-requests --runtime <runtime>"},
            "additional_model_call_required": {"const": false},
            "architect_lineage_required": {"const": true}
          }
        },
        "image_generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["batch_size", "dispatch_mode", "acceptance_mode", "call_strategy", "initial_variants_per_slide", "max_regenerations_per_slide", "automatic_canary", "compile_after_all_images", "reconstruction_starts_before_all_images_complete"],
          "properties": {
            "batch_size": {"const": 20},
            "dispatch_mode": {"const": "concurrent_wave"},
            "acceptance_mode": {"const": "streaming_ready_queue"},
            "call_strategy": {"const": "one_independent_builtin_call_per_slide"},
            "initial_variants_per_slide": {"const": 1},
            "max_regenerations_per_slide": {"const": 1},
            "automatic_canary": {"const": false},
            "compile_after_all_images": {"const": true},
            "reconstruction_starts_before_all_images_complete": {"const": true}
          }
        },
        "reconstruction_authoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_unit", "dispatch_mode", "max_parallel_workers", "shared_file_writer", "worker_scope", "worker_model", "worker_reasoning_effort", "token_policy", "isolated_dual_render_qa_required", "shared_render_source_mapped_qa_required"],
          "properties": {
            "context_unit": {"const": "one_source_slide_per_fresh_context"},
            "dispatch_mode": {"const": "streaming_ready_queue_bounded_workers"},
            "max_parallel_workers": {"const": 6},
            "shared_file_writer": {"const": "integrator_only"},
            "worker_scope": {"const": "one_slide_work_directory_only"},
            "worker_model": {"enum": ["gpt-5.6-terra", "gpt-5.6-sol", "gpt-5.6-luna"]},
            "worker_reasoning_effort": {"enum": ["medium", "max"]},
            "token_policy": {"const": "compact_job_plus_one_source_slide_no_full_deck_duplication"},
            "isolated_dual_render_qa_required": {"const": false},
            "shared_render_source_mapped_qa_required": {"const": true}
          }
        },
        "compilation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["per_slide_isolated_builds", "shared_preview_full_deck_invocation", "final_reconstruction_full_deck_invocation", "full_deck_render_count_without_repair", "post_repair_recompile_only"],
          "properties": {
            "per_slide_isolated_builds": {"const": 0},
            "shared_preview_full_deck_invocation": {"const": true},
            "final_reconstruction_full_deck_invocation": {"const": true},
            "full_deck_render_count_without_repair": {"const": 2},
            "post_repair_recompile_only": {"const": true}
          }
        },
        "performance_target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline_minutes_20_slides", "target_minutes_20_slides", "target_speedup", "measurement_required", "quality_gates_take_precedence"],
          "properties": {
            "baseline_minutes_20_slides": {"const": 120},
            "target_minutes_20_slides": {"const": 30},
            "target_speedup": {"const": 4.0},
            "measurement_required": {"const": true},
            "quality_gates_take_precedence": {"const": true}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"profile_name": {"const": "terra-max"}}},
          "then": {
            "properties": {
              "target_model": {"const": "gpt-5.6-terra"},
              "target_reasoning_effort": {"const": "max"},
              "fallback_policy": {
                "properties": {
                  "profile_name": {"const": null},
                  "max_attempts": {"const": 0},
                  "triggers": {"maxItems": 0}
                }
              },
              "reconstruction_authoring": {
                "properties": {
                  "worker_model": {"const": "gpt-5.6-terra"},
                  "worker_reasoning_effort": {"const": "max"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"profile_name": {"const": "sol-medium"}}},
          "then": {
            "properties": {
              "target_model": {"const": "gpt-5.6-sol"},
              "target_reasoning_effort": {"const": "medium"},
              "fallback_policy": {
                "properties": {
                  "profile_name": {"const": null},
                  "max_attempts": {"const": 0},
                  "triggers": {"maxItems": 0}
                }
              },
              "reconstruction_authoring": {
                "properties": {
                  "worker_model": {"const": "gpt-5.6-sol"},
                  "worker_reasoning_effort": {"const": "medium"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"profile_name": {"const": "luna-max"}}},
          "then": {
            "properties": {
              "target_model": {"const": "gpt-5.6-luna"},
              "target_reasoning_effort": {"const": "max"},
              "fallback_policy": {
                "properties": {
                  "profile_name": {"const": "sol-medium"},
                  "max_attempts": {"const": 1},
                  "triggers": {"minItems": 3, "maxItems": 3}
                }
              },
              "reconstruction_authoring": {
                "properties": {
                  "worker_model": {"const": "gpt-5.6-luna"},
                  "worker_reasoning_effort": {"const": "max"}
                }
              }
            }
          }
        }
      ]
    },
    "quality_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrator_quality_level",
        "renderer_quality",
        "visual_qa_mode",
        "max_repair_wave_size",
        "route_hardlock_required",
        "reconstruction_hardlock_required",
        "pptx_openability_required",
        "zero_fail_required",
        "zero_blocking_required",
        "per_slide_isolated_render_forbidden",
        "shared_preview_render_required",
        "final_reconstruction_render_required",
        "final_full_deck_qa_required",
        "source_slide_mapping_required",
        "full_slide_source_raster_forbidden",
        "high_fidelity_acceptance_required",
        "qa_calibration_profile_required",
        "design_profile_as_qa_profile_forbidden",
        "allowed_needs_polish_issue_types",
        "quality_reference_baseline",
        "allowed_needs_polish_metric_limits"
      ],
      "properties": {
        "orchestrator_quality_level": {"const": "polish"},
        "renderer_quality": {"const": "reconstruction"},
        "visual_qa_mode": {"const": "qa-polish"},
        "max_repair_wave_size": {"const": 5},
        "route_hardlock_required": {"const": true},
        "reconstruction_hardlock_required": {"const": true},
        "pptx_openability_required": {"const": true},
        "zero_fail_required": {"const": true},
        "zero_blocking_required": {"const": true},
        "per_slide_isolated_render_forbidden": {"const": true},
        "shared_preview_render_required": {"const": true},
        "final_reconstruction_render_required": {"const": true},
        "final_full_deck_qa_required": {"const": true},
        "source_slide_mapping_required": {"const": true},
        "full_slide_source_raster_forbidden": {"const": true},
        "high_fidelity_acceptance_required": {"const": true},
        "qa_calibration_profile_required": {"const": true},
        "design_profile_as_qa_profile_forbidden": {"const": true},
        "allowed_needs_polish_issue_types": {
          "const": ["palette_drift", "pptx_html_edge_mismatch"]
        },
        "quality_reference_baseline": {
          "const": "accepted_one_slide_canary_20260808"
        },
        "allowed_needs_polish_metric_limits": {
          "const": {
            "palette_drift": {
              "metric": "color_palette_drift",
              "maximum": 0.265,
              "minimum_ssim": 0.70
            },
            "pptx_html_edge_mismatch": {
              "metric": "edge_difference_ratio",
              "maximum": 0.102,
              "minimum_ssim": 0.82
            }
          }
        }
      }
    },
    "crop_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_crop_plan_required", "empty_plan_is_valid", "skip_crops_flag_forbidden_for_final_delivery", "initial_plan"],
      "properties": {
        "explicit_crop_plan_required": {"const": true},
        "empty_plan_is_valid": {"const": true},
        "skip_crops_flag_forbidden_for_final_delivery": {"const": true},
        "initial_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "crops"],
          "properties": {
            "schema_version": {"const": "1.0.0"},
            "crops": {"type": "array", "maxItems": 0}
          }
        }
      }
    },
    "one_slide_fast_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "cache_manifest_pattern", "probe_before_authoring", "cache_hit_reuses_verified_authoring_inputs", "final_render_and_visual_qa_always_required", "seal_after_final_quality_acceptance", "single_process_final_validation", "html_capture_cache_contract", "capture_cache_exact_bindings_required", "accepted_evidence_binds_both_render_surfaces", "cache_hit_compile_command", "skip_assets_allowed_only_after_cache_hit", "skip_crops_forbidden", "verified_authoring_target_seconds", "eligible_state", "cache_miss_route", "first_time_arbitrary_authoring_sla_claimed", "quality_gate_bypass_forbidden"],
      "properties": {
        "scope": {"const": "one_source_slide_only"},
        "cache_manifest_pattern": {"type": "string", "pattern": "slideXX[\\\\/]one_slide_fast_cache\\.json$"},
        "probe_before_authoring": {"const": true},
        "cache_hit_reuses_verified_authoring_inputs": {"const": true},
        "final_render_and_visual_qa_always_required": {"const": true},
        "seal_after_final_quality_acceptance": {"const": true},
        "single_process_final_validation": {"const": true},
        "html_capture_cache_contract": {"const": "slide-visual-polish-qa.html-capture-cache.v1"},
        "capture_cache_exact_bindings_required": {"const": true},
        "accepted_evidence_binds_both_render_surfaces": {"const": true},
