{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/creative_frontend/template_reference_editable_template_spec.schema.json",
  "title": "Creative Front-End Template Reference Editable Specification",
  "type": "object",
  "required": [
    "schema_version",
    "template_id",
    "design_system_ref",
    "canvas",
    "layouts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "design_system_ref": {
      "type": "string",
      "minLength": 1
    },
    "canvas": {
      "type": "object",
      "required": ["width_in", "height_in", "aspect_ratio"],
      "additionalProperties": false,
      "properties": {
        "width_in": {
          "type": "number",
          "minimum": 1
        },
        "height_in": {
          "type": "number",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^(\\d+\\.?\\d*):(\\d+\\.?\\d*)$"
        }
      }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/layout"
      }
    }
  },
  "definitions": {
    "layout": {
      "type": "object",
      "required": [
        "layout_id",
        "archetype",
        "background",
        "bounds",
        "slots",
        "components",
        "confidence",
        "assumptions",
        "fallback_layout",
        "hierarchy"
      ],
      "additionalProperties": false,
      "properties": {
        "layout_id": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "enum": [
            "cover_hero",
            "section_divider",
            "agenda_roadmap",
            "standard_content",
            "two_column_analysis",
            "card_grid",
            "process_timeline",
            "comparison_matrix",
            "data_dashboard",
            "table_heavy",
            "case_study",
            "closing"
          ]
        },
        "background": {
          "type": "object",
          "required": ["type", "bounds", "editable"],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            },
            "bounds": {
              "$ref": "#/definitions/bounds"
            },
            "editable": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true
            },
            "full_slide": {
              "type": "boolean"
            }
          }
        },
        "bounds": {
          "$ref": "#/definitions/bounds"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slot"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/component"
          }
        },
        "hierarchy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Render order of slot/component ids."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback_layout": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "slot": {
      "type": "object",
      "required": [
        "slot_id",
        "type",
        "role",
        "bounds",
        "editable",
        "density",
        "style_ref",
        "confidence",
        "fallback_behavior"
      ],
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "chart",
            "table",
            "kpi",
            "card_group",
            "callout",
            "footer",
            "icon",
            "decorative"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "$ref": "#/definitions/bounds"
        },
        "editable": {
          "type": "boolean"
        },
        "density": {
          "type": "string",
          "enum": ["sparse", "normal", "dense"]
        },
        "style_ref": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fallback_behavior": {
          "type": "string",
          "minLength": 1
        },
        "hierarchy": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_input_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["component_id", "type", "bounds", "editable", "confidence"],
      "additionalProperties": true,
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "rect",
            "rounded_rect",
            "line",
            "freeform_polygon",
            "text_box",
            "image_frame",
            "chart_frame",
            "table_frame",
            "svg_icon",
            "svg_layer",
            "group",
            "footer_component"
          ]
        },
        "slot_ref": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/definitions/bounds"
        },
        "editable": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decorative_svg": {
          "type": "boolean"
        },
        "non_raster": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/component"
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
