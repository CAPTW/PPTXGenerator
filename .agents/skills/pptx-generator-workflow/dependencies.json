{
  "schema_name": "pptx_generator_codex_skill_dependencies",
  "schema_version": "1.6.0",
  "execution_profile": {
    "name": "fast-quality-20",
    "target_model": "gpt-5.6-sol",
    "target_reasoning_effort": "medium",
    "default_design_direction": [
      "Academic",
      "Informative",
      "Professional",
      "Creative"
    ],
    "image_generation_batch_size": 20,
    "image_generation_dispatch": "concurrent_wave",
    "image_acceptance_mode": "streaming_ready_queue",
    "reconstruction_starts_before_image_wave_complete": true,
    "full_deck_compile_mode": "shared_preview_final_fast_path",
    "full_deck_render_count_without_repair": 2,
    "isolated_per_slide_build_count": 0,
    "node_install_mode": "prefer_offline_no_audit_no_fund_once_per_run",
    "max_repair_iterations": 2,
    "baseline_minutes_20_slides": 120,
    "target_minutes_20_slides": 30,
    "target_speedup": 4.0,
    "image_request_preparation": "single_deterministic_pass_no_model_call",
    "vector_preflight": "raw_measured_bounded_svg_no_model_call",
    "max_parallel_vector_measurement_workers": 2,
    "reconstruction_context_unit": "one_source_slide_per_fresh_context",
    "reconstruction_dispatch": "streaming_ready_queue_bounded_workers",
    "max_parallel_reconstruction_workers": 6,
    "shared_reconstruction_writer": "integrator_only",
    "reconstruction_token_policy": "compact_job_plus_one_source_slide_no_full_deck_duplication"
  },
  "ordered_dependencies": [
    {
      "invocation_order": 1,
      "skill_name": "pptx-workflow-architect",
      "skill_path": ".agents/skills/pptx-workflow-architect/SKILL.md",
      "distribution": "repository_owned",
      "package_files": [
        "SKILL.md",
        "references/design-system.md",
        "references/large-deck.md",
        "references/production-qa.md"
      ],
      "required_before": [
        "repository_planning",
        "image_generation",
        "pngtopptx_reconstruction"
      ]
    },
    {
      "invocation_order": 2,
      "skill_name": "imagegen",
      "skill_path": "${CODEX_HOME}/skills/.system/imagegen/SKILL.md",
      "platform_tool_id": "image_gen.imagegen",
      "call_strategy": "one_independent_builtin_call_per_slide",
      "dispatch_mode": "concurrent_wave",
      "acceptance_mode": "streaming_ready_queue",
      "batch_size": 20,
      "max_regenerations_per_slide": 1,
      "request_manifest": "image_requests/image_request_manifest.json"
    },
    {
      "invocation_order": 3,
      "skill_name": "slide-editable-deck-orchestrator",
      "skill_path": "${CODEX_HOME}/skills/slide-editable-deck-orchestrator/SKILL.md",
      "minimum_quality_level": "blocking-zero",
      "default_quality_level": "polish"
    },
    {
      "invocation_order": 4,
      "skill_name": "slide-text-layer-inpaint",
      "skill_path": "${CODEX_HOME}/skills/slide-text-layer-inpaint/SKILL.md",
      "invocation_policy": "conditional_with_recorded_execute_or_skip_decision"
    },
    {
      "invocation_order": 5,
      "skill_name": "slide-image-dual-render",
      "skill_path": "${CODEX_HOME}/skills/slide-image-dual-render/SKILL.md",
      "renderer_quality": "reconstruction",
      "official_entrypoint": "scripts/slide_pipeline.js",
      "final_gate": "scripts/final_gate.js",
      "worker_validator": "scripts/validate_agent_work.js",
      "worker_integrator": "scripts/integrate_subagent_work.js"
    },
    {
      "invocation_order": 6,
      "skill_name": "slide-visual-polish-qa",
      "skill_path": "${CODEX_HOME}/skills/slide-visual-polish-qa/SKILL.md",
      "qa_mode": "qa-polish",
      "source_slide_mapping_required": true
    }
  ],
  "pngtosvg_preflight": {
    "source_pipeline": "PPTXlocal/raw/pipeline",
    "resolution_order": [
      "--pipeline-root",
      "PPTXLOCAL_RAW_PNGTOSVG_ROOT",
      "repository ancestor auto-discovery"
    ],
    "python_resolution_order": [
      "--python-executable",
      "PPTXLOCAL_RAW_PYTHON",
      "deckcompiler interpreter"
    ],
    "detector_mode": "native_canvas_deep_text_and_deep_scan",
    "measurement_dispatch": "two_bounded_batch_processes_shared_reader_per_worker",
    "deep_runtime_requirements": [
      "pytesseract",
      "tesseract executable",
      "eng language pack",
      "kor language pack"
    ],
    "reuse_mode": "external_measurement_engine_no_repo_local_fork",
    "maximum_vector_region_area_ratio": 0.35,
    "semantic_text_vectorization_forbidden": true,
    "continuous_tone_vectorization_forbidden": true,
    "full_slide_vectorization_forbidden": true,
    "canonical_renderer": "slide-image-dual-render"
  },
  "completion_requirements": {
    "architect_gate_1": "APPROVED",
    "architect_gate_2": "APPROVED",
    "image_generation_coverage": 1.0,
    "route_hardlock": "PASS",
    "reconstruction_hardlock": "PASS",
    "pptx_openability": "PASS",
    "exact_skillset_execution_plan": "PASS",
    "explicit_crop_plan_and_manifest": "PASS",
    "image_generation_batch_manifest": "PASS",
    "architect_to_image_request_lineage": "PASS",
    "raw_pngtosvg_vector_preflight": "PASS",
    "vector_preflight_hash_binding": "PASS",
    "isolated_reconstruction_job_lineage": "PASS",
    "integrator_owned_shared_outputs": "PASS",
    "streaming_overlap_evidence": "PASS",
    "shared_preview_and_final_render_path": "PASS",
    "zero_isolated_per_slide_builds": "PASS",
    "source_mapped_visual_qa": "PASS",
    "final_full_deck_visual_qa": "PASS",
    "final_visual_qa_output_hash_binding": "PASS",
    "high_fidelity_issue_acceptance": "PASS",
    "visual_qa_fail_count": 0,
    "visual_qa_blocking_count": 0
  }
}
