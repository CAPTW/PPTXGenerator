{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/deckcompiler/phase4-semantic-sidecar.schema.json",
  "title": "DeckCompiler Phase 4 Semantic Sidecar Wrapper",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "sidecar_id", "expected_visual_target_id", "source_commit", "sidecar", "phase4_metadata", "artifact_hash"],
  "properties": {
    "schema_name": {"const": "phase4_semantic_sidecar"},
    "schema_version": {"const": "1.0.0"},
    "sidecar_id": {"type": "string", "minLength": 1},
    "expected_visual_target_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sidecar": {"$ref": "https://presentation-agent.local/schemas/slide_semantic_sidecar.schema.json"},
    "phase4_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_role", "primary_message", "exact_title", "exact_subtitle", "exact_body_blocks", "exact_labels", "exact_numbers", "exact_units", "structured_table_data", "structured_chart_data", "diagram_nodes", "diagram_edges", "citations", "evidence_unit_bindings", "canonical_content_hashes", "source_note_policy", "native_required_slot_ids", "raster_allowed_slot_ids", "accessibility_description", "speaker_note_candidates", "factual_content_item_ids", "full_slide_raster_forbidden", "ocr_canonical_text_forbidden", "visual_target_is_not_semantic_source"
      ],
      "properties": {
        "slide_role": {"type": "string", "minLength": 1},
        "primary_message": {"type": "string", "minLength": 1},
        "exact_title": {"type": "string", "minLength": 1},
        "exact_subtitle": {"type": "string"},
        "exact_body_blocks": {"type": "array", "items": {"type": "object"}},
        "exact_labels": {"type": "array", "items": {"type": "string"}},
        "exact_numbers": {"type": "array", "items": {"type": "object"}},
        "exact_units": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "structured_table_data": {},
        "structured_chart_data": {},
        "diagram_nodes": {"type": "array", "items": {"type": "object"}},
        "diagram_edges": {"type": "array", "items": {"type": "object"}},
        "citations": {"type": "array", "items": {"type": "object"}},
        "evidence_unit_bindings": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "canonical_content_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "source_note_policy": {"type": "string", "minLength": 1},
        "native_required_slot_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "raster_allowed_slot_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "accessibility_description": {"type": "string", "minLength": 1},
        "speaker_note_candidates": {"type": "array", "items": {"type": "string"}},
        "factual_content_item_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "full_slide_raster_forbidden": {"const": true},
        "ocr_canonical_text_forbidden": {"const": true},
        "visual_target_is_not_semantic_source": {"const": true}
      }
    },
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
