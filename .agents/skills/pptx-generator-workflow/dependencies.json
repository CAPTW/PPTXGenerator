{
  "schema_name": "pptx_generator_codex_skill_dependencies",
  "schema_version": "1.4.0",
  "execution_profile": {
    "name": "fast-quality-20",
    "target_model": "gpt-5.6-sol",
    "target_reasoning_effort": "medium",
    "default_design_direction": [
      "Academic",
      "Informative",
      "Professional",
      "Creative"
    ],
    "image_generation_batch_size": 20,
    "image_generation_dispatch": "concurrent_wave",
    "full_deck_compile_mode": "single_compile_fast_path",
    "unconditional_second_full_compile": false,
    "node_install_mode": "prefer_offline_no_audit_no_fund_once_per_run",
    "max_repair_iterations": 2,
    "baseline_minutes_20_slides": 120,
    "target_minutes_20_slides": 30,
    "target_speedup": 4.0,
    "image_request_preparation": "single_deterministic_pass_no_model_call"
  },
  "ordered_dependencies": [
    {
      "invocation_order": 1,
      "skill_name": "pptx-workflow-architect",
      "skill_path": ".agents/skills/pptx-workflow-architect/SKILL.md",
      "distribution": "repository_owned",
      "package_files": [
        "SKILL.md",
        "references/design-system.md",
        "references/large-deck.md",
        "references/production-qa.md"
      ],
      "required_before": [
        "repository_planning",
        "image_generation",
        "pngtopptx_reconstruction"
      ]
    },
    {
      "invocation_order": 2,
      "skill_name": "imagegen",
      "skill_path": "${CODEX_HOME}/skills/.system/imagegen/SKILL.md",
      "platform_tool_id": "image_gen.imagegen",
      "call_strategy": "one_independent_builtin_call_per_slide",
      "dispatch_mode": "concurrent_wave",
      "batch_size": 20,
      "max_regenerations_per_slide": 1,
      "request_manifest": "image_requests/image_request_manifest.json"
    },
    {
      "invocation_order": 3,
      "skill_name": "slide-editable-deck-orchestrator",
      "skill_path": "${CODEX_HOME}/skills/slide-editable-deck-orchestrator/SKILL.md",
      "minimum_quality_level": "blocking-zero",
      "default_quality_level": "polish"
    },
    {
      "invocation_order": 4,
      "skill_name": "slide-text-layer-inpaint",
      "skill_path": "${CODEX_HOME}/skills/slide-text-layer-inpaint/SKILL.md",
      "invocation_policy": "conditional_with_recorded_execute_or_skip_decision"
    },
    {
      "invocation_order": 5,
      "skill_name": "slide-image-dual-render",
      "skill_path": "${CODEX_HOME}/skills/slide-image-dual-render/SKILL.md",
      "renderer_quality": "reconstruction",
      "official_entrypoint": "scripts/slide_pipeline.js",
      "final_gate": "scripts/final_gate.js"
    },
    {
      "invocation_order": 6,
      "skill_name": "slide-visual-polish-qa",
      "skill_path": "${CODEX_HOME}/skills/slide-visual-polish-qa/SKILL.md",
      "qa_mode": "qa-polish",
      "source_slide_mapping_required": true
    }
  ],
  "completion_requirements": {
    "architect_gate_1": "APPROVED",
    "architect_gate_2": "APPROVED",
    "image_generation_coverage": 1.0,
    "route_hardlock": "PASS",
    "reconstruction_hardlock": "PASS",
    "pptx_openability": "PASS",
    "exact_skillset_execution_plan": "PASS",
    "explicit_crop_plan_and_manifest": "PASS",
    "image_generation_batch_manifest": "PASS",
    "architect_to_image_request_lineage": "PASS",
    "single_compile_fast_path_or_conditional_post_repair_recompile": "PASS",
    "source_mapped_visual_qa": "PASS",
    "final_full_deck_visual_qa": "PASS",
    "final_visual_qa_output_hash_binding": "PASS",
    "visual_qa_fail_count": 0,
    "visual_qa_blocking_count": 0
