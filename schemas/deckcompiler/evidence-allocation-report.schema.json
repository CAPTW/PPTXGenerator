{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/evidence-allocation-report.schema.json",
  "title": "DeckCompiler Evidence Allocation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "report_id", "adapter_version", "ordered_slide_ids", "slides", "represented_documentary_source_ids", "presentation_plan_content_sha256", "slide_blueprint_collection_content_sha256", "every_factual_claim_evidence_bound", "duplicate_primary_objectives"],
  "properties": {
    "schema_name": {"const": "evidence_allocation_report"},
    "schema_version": {"const": "1.0.0"},
    "artifact": {"allOf": [{"$ref": "artifact-envelope.schema.json"}, {"properties": {"artifact_type": {"const": "evidence_allocation_report"}}}]},
    "report_id": {"type": "string", "pattern": "^allocation_[0-9a-f]{20}$"},
    "adapter_version": {"const": "deckcompiler-source-to-strict-v1"},
    "ordered_slide_ids": {"type": "array", "minItems": 5, "maxItems": 6, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "slides": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "role", "primary_objective", "claim_origin", "evidence_ids", "source_ids", "documentary_source_ids"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "primary_objective": {"type": "string", "minLength": 1},
          "claim_origin": {"enum": ["documentary_fact", "prompt_derived", "inference"]},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ev_[0-9a-f]{20}$"}, "uniqueItems": true},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"}, "uniqueItems": true},
          "documentary_source_ids": {"type": "array", "items": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"}, "uniqueItems": true}
        }
      }
    },
    "represented_documentary_source_ids": {"type": "array", "items": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"}, "uniqueItems": true},
    "presentation_plan_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slide_blueprint_collection_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "every_factual_claim_evidence_bound": {"const": true},
    "duplicate_primary_objectives": {"type": "array", "maxItems": 0}
  }
}
