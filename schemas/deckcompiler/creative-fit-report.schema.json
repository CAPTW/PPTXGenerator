{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/creative-fit-report.schema.json",
  "title": "DeckCompiler Planning Creative Fit Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "report_id", "creative_architecture_id", "planning_level_only", "geometry_aware_fit_deferred_to_phase4", "candidate_families", "decisions", "forbidden_actions", "repair_executed"],
  "properties": {
    "schema_name": {"const": "creative_fit_report"}, "schema_version": {"const": "1.0.0"},
    "artifact": {"allOf": [{"$ref": "artifact-envelope.schema.json"}, {"properties": {"artifact_type": {"const": "creative_fit_report"}}}]},
    "report_id": {"type": "string", "pattern": "^fit_[0-9a-f]{20}$"}, "creative_architecture_id": {"type": "string", "minLength": 1},
    "planning_level_only": {"const": true}, "geometry_aware_fit_deferred_to_phase4": {"const": true},
    "candidate_families": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/candidate"}},
    "decisions": {"type": "array", "minItems": 5, "maxItems": 6, "items": {"$ref": "#/$defs/decision"}},
    "forbidden_actions": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "repair_executed": {"const": false}
  },
  "$defs": {
    "scores": {"type": "object", "additionalProperties": false, "required": ["semantic", "capacity", "editability", "differentiation"], "properties": {"semantic": {"type": "number", "minimum": 0, "maximum": 1}, "capacity": {"type": "number", "minimum": 0, "maximum": 1}, "editability": {"type": "number", "minimum": 0, "maximum": 1}, "differentiation": {"type": "number", "minimum": 0, "maximum": 1}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["family_id", "semantic_compatibility", "supported_slide_roles", "composition_archetype", "capacity_intent", "editability_intent", "differentiation_intent", "expected_visual_regions", "prohibited_uses"], "properties": {"family_id": {"type": "string", "minLength": 1}, "semantic_compatibility": {"type": "string", "minLength": 1}, "supported_slide_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "composition_archetype": {"type": "string", "minLength": 1}, "capacity_intent": {"type": "string", "minLength": 1}, "editability_intent": {"type": "string", "minLength": 1}, "differentiation_intent": {"type": "string", "minLength": 1}, "expected_visual_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "prohibited_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["slide_id", "selected_family_id", "selected_layout_archetype", "status", "scores", "reason", "action_type", "action_owner_artifact", "action_target_artifact", "forbidden_action_detected"], "properties": {"slide_id": {"type": "string", "minLength": 1}, "selected_family_id": {"type": "string", "minLength": 1}, "selected_layout_archetype": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "recompose_content", "expand_template_family", "blocked"]}, "scores": {"$ref": "#/$defs/scores"}, "reason": {"type": "string", "minLength": 1}, "action_type": {"type": ["string", "null"]}, "action_owner_artifact": {"type": ["string", "null"]}, "action_target_artifact": {"type": ["string", "null"]}, "forbidden_action_detected": {"const": false}}}
  }
}
