{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pptx-generator.local/schemas/deckcompiler/devpost-evidence-index.schema.json", "title": "DeckCompiler DevPost evidence index", "type": "object", "additionalProperties": false,
