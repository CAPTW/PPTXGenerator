{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/qa_report.schema.json",
  "title": "QAReport",
  "type": "object",
  "required": [
    "stage",
    "status",
    "inputs",
    "outputs",
    "source_evidence",
    "created_at"
  ],
  "properties": {
    "stage": {
      "const": "QA"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "REPAIRABLE_FAIL"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_evidence": {
      "$ref": "intake_manifest.schema.json#/$defs/sourceEvidenceList"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidates_downstream_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "issues": {
      "type": "array"
    },
    "repair_actions": {
      "type": "array"
    },
    "next_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_qa_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "qa_summary": {
      "type": "object"
    },
    "build_manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "slide_build_linkage_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "slide_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "warning_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "blocking_count": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
