{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/release-candidate-gate.schema.json",
  "title": "DeckCompiler Phase 7C release candidate gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "gate_id",
    "tested_runtime_commit",
    "prerequisites",
    "status",
    "phase7c_accepted",
    "phase7d_ready",
    "phase7d_required",
    "final_release_eligible",
    "devpost_release_eligible",
    "submission_performed",
    "push_performed",
    "tag_created",
    "created_at",
    "gate_hash"
  ],
  "properties": {
    "schema_name": {"const": "release_candidate_gate"},
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"type": "string", "minLength": 1},
    "tested_runtime_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demo_run_pass",
        "fresh_pptx_html",
        "render_6_of_6",
        "html_screenshot_6_of_6",
        "composite_qa_pass",
        "phase6_proof_pass",
        "package_complete",
        "manifest_valid",
        "zip_valid",
        "security_path_scan_pass",
        "license_provenance_pass",
        "repeat_semantic_determinism_pass",
        "source_tree_clean",
        "external_skill_unchanged",
        "phase4_phase5_phase6_unchanged"
      ],
      "properties": {
        "demo_run_pass": {"type": "boolean"},
        "fresh_pptx_html": {"type": "boolean"},
        "render_6_of_6": {"type": "boolean"},
        "html_screenshot_6_of_6": {"type": "boolean"},
        "composite_qa_pass": {"type": "boolean"},
        "phase6_proof_pass": {"type": "boolean"},
        "package_complete": {"type": "boolean"},
        "manifest_valid": {"type": "boolean"},
        "zip_valid": {"type": "boolean"},
        "security_path_scan_pass": {"type": "boolean"},
        "license_provenance_pass": {"type": "boolean"},
        "repeat_semantic_determinism_pass": {"type": "boolean"},
        "source_tree_clean": {"type": "boolean"},
        "external_skill_unchanged": {"type": "boolean"},
        "phase4_phase5_phase6_unchanged": {"type": "boolean"}
      }
    },
    "status": {"enum": ["BLOCKED", "ELIGIBLE_FOR_FRESH_CLONE_PROOF"]},
    "phase7c_accepted": {"type": "boolean"},
    "phase7d_ready": {"type": "boolean"},
    "phase7d_required": {"const": true},
    "final_release_eligible": {"const": false},
    "devpost_release_eligible": {"const": false},
    "submission_performed": {"const": false},
    "push_performed": {"const": false},
    "tag_created": {"const": false},
    "created_at": {"format": "date-time", "type": "string"},
    "gate_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
