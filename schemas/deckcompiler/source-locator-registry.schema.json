{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/source-locator-registry.schema.json",
  "title": "DeckCompiler Phase 3 Source Locator Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "registry_id", "locators", "pdf_documents"],
  "properties": {
    "schema_name": {"const": "source_locator_registry"},
    "schema_version": {"const": "1.0.0"},
    "artifact": {
      "allOf": [
        {"$ref": "artifact-envelope.schema.json"},
        {"properties": {"artifact_type": {"const": "source_locator_registry"}}}
      ]
    },
    "registry_id": {"type": "string", "pattern": "^locators_[0-9a-f]{20}$"},
    "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
    "pdf_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "page_count", "normalized_page_text_sha256", "extraction_method", "text_searchable", "legacy_adapter", "legacy_structural_hash"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"},
          "page_count": {"type": "integer", "minimum": 1},
          "normalized_page_text_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "extraction_method": {"const": "pymupdf_text_blocks"},
          "text_searchable": {"const": true},
          "legacy_adapter": {"const": "presentation_agent.source_ingestion.ingest_source_file"},
          "legacy_structural_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "charRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "unit": {"const": "normalized"}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_id", "source_id", "locator_type", "char_range", "quote", "text_sha256", "extraction_method", "extraction_warning", "text_searchable"],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^loc_[0-9a-f]{20}$"},
        "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"},
        "locator_type": {"enum": ["user_prompt", "pdf_text_block"]},
        "page_number": {"type": "integer", "minimum": 1},
        "page_index": {"type": "integer", "minimum": 0},
        "block_index": {"type": "integer", "minimum": 0},
        "chunk_id": {"type": "string", "pattern": "^chunk_[0-9a-f]{20}$"},
        "char_range": {"$ref": "#/$defs/charRange"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "quote": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extraction_method": {"enum": ["user_prompt_normalization", "pymupdf_text_blocks"]},
        "extraction_warning": {"type": ["string", "null"]},
        "text_searchable": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"locator_type": {"const": "pdf_text_block"}}, "required": ["locator_type"]},
          "then": {"required": ["page_number", "page_index", "block_index", "chunk_id", "bbox"]}
        }
      ]
    }
  }
}
