{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/creative_template_architecture.schema.json",
  "title": "CreativeTemplateArchitecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "architecture_id",
    "deck_id",
    "presentation_architecture_id",
    "template_pack_id",
    "global_visual_dna",
    "modules",
    "fit_policy",
    "slide_fit_decisions",
    "template_reference_policy"
  ],
  "properties": {
    "schema_name": {"const": "creative_template_architecture"},
    "schema_version": {"type": "string", "minLength": 1},
    "architecture_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "presentation_architecture_id": {"type": "string", "minLength": 1},
    "template_pack_id": {"type": "string", "minLength": 1},
    "global_visual_dna": {"$ref": "#/$defs/globalVisualDna"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/moduleDirection"}
    },
    "fit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_threshold", "weights", "max_repair_waves", "max_consecutive_layout", "max_consecutive_family"],
      "properties": {
        "pass_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic", "capacity", "editability", "differentiation"],
          "properties": {
            "semantic": {"type": "number", "minimum": 0, "maximum": 1},
            "capacity": {"type": "number", "minimum": 0, "maximum": 1},
            "editability": {"type": "number", "minimum": 0, "maximum": 1},
            "differentiation": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "max_repair_waves": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_consecutive_layout": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_consecutive_family": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "slide_fit_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fitDecision"}
    },
    "template_reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_generation_scope", "content_rendering_allowed", "preferred_reference_unit"],
      "properties": {
        "image_generation_scope": {"const": "template_references_only"},
        "content_rendering_allowed": {"const": false},
        "preferred_reference_unit": {"enum": ["archetype", "batch_family"]}
      }
    }
  },
  "$defs": {
    "globalVisualDna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariants",
        "color_roles",
        "typography_roles",
        "allowed_raster_roles",
        "forbidden_raster_roles"
      ],
      "properties": {
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "color_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "typography_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "allowed_raster_roles": {
          "type": "array",
          "items": {"enum": ["photo", "source_figure", "replaceable_image_frame"]},
          "uniqueItems": true
        },
        "forbidden_raster_roles": {
          "type": "array",
          "contains": {"const": "full_slide_background"},
          "items": {"enum": ["full_slide_background", "text", "table", "chart", "card", "footer"]},
          "uniqueItems": true
        }
      }
    },
    "moduleDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "art_direction",
        "differentiation_signature",
        "batch_template_families"
      ],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "art_direction": {"type": "string", "minLength": 1},
        "differentiation_signature": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "batch_template_families": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/batchFamilies"}
        }
      }
    },
    "batchFamilies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "candidate_family_ids", "selected_family_ids", "reference_brief"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "candidate_family_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "selected_family_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reference_brief": {"type": "string", "minLength": 1}
      }
    },
    "fitDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_id",
        "module_id",
        "batch_id",
        "layout_id",
        "template_family_id",
        "scores",
        "overall_score",
        "status",
        "reasons",
        "next_actions"
      ],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "module_id": {"type": "string", "minLength": 1},
        "batch_id": {"type": "string", "minLength": 1},
        "layout_id": {"type": "string", "minLength": 1},
        "template_family_id": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic", "capacity", "editability", "differentiation"],
          "properties": {
            "semantic": {"type": "number", "minimum": 0, "maximum": 1},
            "capacity": {"type": "number", "minimum": 0, "maximum": 1},
            "editability": {"type": "number", "minimum": 0, "maximum": 1},
            "differentiation": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "overall_score": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["pass", "recompose_content", "expand_template_family", "blocked"]},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "next_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
