{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/evidence-unit-registry.schema.json",
  "title": "DeckCompiler Evidence Unit Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "registry_id", "evidence_units"],
  "properties": {
    "schema_name": {"const": "evidence_unit_registry"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {
      "allOf": [
        {"$ref": "artifact-envelope.schema.json"},
        {"properties": {"artifact_type": {"const": "evidence_unit_registry"}}}
      ]
    },
    "registry_id": {"type": "string", "pattern": "^registry_[0-9a-f]{20}$"},
    "evidence_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence-unit.schema.json"}
    }
  }
}
