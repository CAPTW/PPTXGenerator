{
  "$defs": {
    "ProofArtifactDoctorSurface": {
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "sunset_status": {
          "default": "unknown-or-deferred",
          "title": "Sunset Status",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "location",
        "classification",
        "rationale"
      ],
      "title": "ProofArtifactDoctorSurface",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "default": "",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_root": {
      "title": "Workspace Root",
      "type": "string"
    },
    "config_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
