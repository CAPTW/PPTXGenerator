    "would_change": {
      "items": {
        "type": "string"
      },
      "title": "Would Change",
      "type": "array"
    },
    "applied_changes": {
      "items": {
        "type": "string"
      },
      "title": "Applied Changes",
      "type": "array"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    }
  },
  "required": [
    "workspace_root"
