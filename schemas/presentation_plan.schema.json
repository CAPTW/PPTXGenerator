{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/presentation_plan.schema.json",
  "title": "PresentationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deck_title",
    "audience",
    "objective",
    "tone",
    "source_summary",
    "narrative_structure",
    "sections",
    "slide_count_target",
    "slide_archetypes_needed",
    "constraints"
  ],
  "properties": {
    "schema_name": {
      "const": "presentation_plan"
    },
    "schema_version": {
      "type": "string"
    },
    "deck_title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "source_summary": {
      "type": "string",
      "minLength": 1
    },
    "narrative_structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "label",
          "purpose"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "title",
          "purpose",
          "slide_count"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "slide_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "slide_count_target": {
      "type": "integer",
      "minimum": 1
    },
    "slide_archetypes_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
