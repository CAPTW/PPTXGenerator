    "exact_body_blocks": [
      {
        "content_item_id": "slide-03-risk-findings-evidence-01",
        "slot": "body",
        "text": "Redundant sensing reduces single-point blind spots but does not remove calibration drift risk.",
        "type": "source_evidence"
      },
      {
        "content_item_id": "slide-03-risk-findings-evidence-02",
        "slot": "body",
        "text": "A loss of reliable flow telemetry can hide a developing restriction until component temperatures begin to rise.",
        "type": "source_evidence"
      },
      {
        "content_item_id": "slide-03-risk-findings-evidence-03",
        "slot": "body",
        "text": "Shared heat-rejection saturation can affect multiple compute rows at the same time.",
        "type": "source_evidence"
      },
      {
        "content_item_id": "slide-03-risk-findings-evidence-04",
        "slot": "body",
        "text": "A combined option can address both rapid flow loss and slower sensor degradation without requiring a full plant redesign.",
        "type": "source_evidence"
      },
      {
        "content_item_id": "slide-03-risk-findings-evidence-05",
        "slot": "body",
        "text": "Facility heat-rejection capacity remains a shared upstream constraint even when the primary loop is healthy.",
        "type": "source_evidence"
      }
    ],
