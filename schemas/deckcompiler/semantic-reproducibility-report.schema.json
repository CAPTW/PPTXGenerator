{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/semantic-reproducibility-report.schema.json",
  "title": "DeckCompiler semantic reproducibility report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "comparison_id",
    "run_ids",
    "semantic_artifact_hash_maps_equal",
    "slide_ids_order_equal",
    "sidecar_hashes_equal",
    "visual_target_hashes_equal",
    "evidence_bindings_equal",
    "pptx_structural_fingerprint_equal",
    "html_structural_fingerprint_equal",
    "logical_delivery_fingerprint_equivalent",
    "ignored_volatile_fields",
    "mismatch_fields",
    "unexplained_divergence_count",
    "status",
    "report_hash"
  ],
  "properties": {
    "schema_name": {"const": "semantic_reproducibility_report"},
    "schema_version": {"const": "1.0.0"},
    "comparison_id": {"type": "string", "minLength": 1},
    "run_ids": {"type": "array", "minItems": 2, "maxItems": 2},
    "semantic_artifact_hash_maps_equal": {"type": "boolean"},
    "slide_ids_order_equal": {"type": "boolean"},
    "sidecar_hashes_equal": {"type": "boolean"},
    "visual_target_hashes_equal": {"type": "boolean"},
    "evidence_bindings_equal": {"type": "boolean"},
    "pptx_structural_fingerprint_equal": {"type": "boolean"},
    "html_structural_fingerprint_equal": {"type": "boolean"},
    "logical_delivery_fingerprint_equivalent": {"type": "boolean"},
    "ignored_volatile_fields": {"type": "array", "items": {"type": "string"}},
    "mismatch_fields": {"type": "array", "items": {"type": "string"}},
    "unexplained_divergence_count": {"minimum": 0, "type": "integer"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "report_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
