{
  "$id": "https://pptx-generator.local/schemas/deckcompiler/repair-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckCompiler Phase 6 bounded repair plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": { "const": "phase6_repair_plan" },
    "schema_version": { "const": "1.0.0" },
    "plan_id": { "pattern": "^repair_plan_[0-9a-f]{20}$", "type": "string" },
    "fixture_id": { "minLength": 1, "type": "string" },
    "source_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "source_detection_report_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "source_fault_application_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "source_fixture_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "source_repair_contract_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "finding_ids": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array", "uniqueItems": true },
    "source_detector": { "minLength": 1, "type": "string" },
    "canonical_repair_owner": { "const": "src/presentation_agent/deckcompiler/qa/reconstruction_source/slides.js" },
    "target_field": { "minLength": 1, "type": "string" },
    "repair_action": { "const": "rematerialize_canonical_owner" },
    "baseline_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "faulty_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "expected_repaired_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "invalidated_artifact_ids": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array", "uniqueItems": true },
    "current_wave": { "const": 1 },
    "maximum_outer_waves": { "const": 3 },
    "direct_final_pptx_patch": { "const": false },
    "direct_final_html_patch": { "const": false },
    "semantic_content_change": { "const": false },
    "evidence_binding_change": { "const": false },
    "visual_target_change": { "const": false },
    "created_at": { "format": "date-time", "type": "string" },
    "timezone": { "const": "Asia/Seoul" },
    "plan_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
  },
  "required": ["schema_name", "schema_version", "plan_id", "fixture_id", "source_commit", "source_detection_report_hash", "source_fault_application_hash", "source_fixture_hash", "source_repair_contract_hash", "finding_ids", "source_detector", "canonical_repair_owner", "target_field", "repair_action", "baseline_sha256", "faulty_sha256", "expected_repaired_sha256", "invalidated_artifact_ids", "current_wave", "maximum_outer_waves", "direct_final_pptx_patch", "direct_final_html_patch", "semantic_content_change", "evidence_binding_change", "visual_target_change", "created_at", "timezone", "plan_hash"]
}
