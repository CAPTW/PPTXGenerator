{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/git-object-bundle-fingerprint.schema.json",
  "title": "DeckCompiler Git-object bundle fingerprint v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "blob_oid", "byte_size", "blob_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "mode": {"enum": ["100644", "100755"]},
        "blob_oid": {"$ref": "#/$defs/objectOid"},
        "byte_size": {"type": "integer", "minimum": 0},
        "blob_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fingerprintPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "record_ordering", "serialization", "aggregate_sha256", "records"],
      "properties": {
        "algorithm": {"const": "git_object_bundle_fingerprint_v1"},
        "record_ordering": {"const": "unicode_code_point_ordinal_over_normalized_posix_paths"},
        "serialization": {"const": "compact_sorted_key_json_utf8_no_bom_no_trailing_newline"},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "record_ordering",
    "serialization",
    "records",
    "aggregate_sha256",
    "path_set_sha256",
    "file_count",
    "total_blob_bytes",
    "source_commit",
    "subtree_path",
    "subtree_tree_oid"
  ],
  "properties": {
    "algorithm": {"const": "git_object_bundle_fingerprint_v1"},
    "record_ordering": {"const": "unicode_code_point_ordinal_over_normalized_posix_paths"},
    "serialization": {"const": "compact_sorted_key_json_utf8_no_bom_no_trailing_newline"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "aggregate_sha256": {"$ref": "#/$defs/sha256"},
    "path_set_sha256": {"$ref": "#/$defs/sha256"},
    "file_count": {"type": "integer", "minimum": 0},
    "total_blob_bytes": {"type": "integer", "minimum": 0},
    "source_commit": {"$ref": "#/$defs/objectOid"},
    "subtree_path": {"type": "string", "minLength": 1},
    "subtree_tree_oid": {"$ref": "#/$defs/objectOid"}
  }
}
