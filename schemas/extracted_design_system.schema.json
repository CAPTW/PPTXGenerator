{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/extracted_design_system.schema.json",
  "title": "ExtractedDesignSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_template_images",
    "canvas",
    "detected_palette",
    "typography_estimates",
    "layout_grid",
    "safe_margins",
    "component_observations",
    "footer_observations",
    "card_observations",
    "chart_frame_observations",
    "table_frame_observations",
    "image_frame_observations",
    "diagonal_panel_observations",
    "background_ornament_observations",
    "density_profile",
    "confidence_scores",
    "extraction_warnings"
  ],
  "properties": {
    "schema_name": {
      "const": "extracted_design_system"
    },
    "schema_version": {
      "type": "string"
    },
    "source_template_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archetype_id",
          "image_path",
          "prompt_file",
          "source_role"
        ],
        "properties": {
          "archetype_id": {
            "type": "string",
            "minLength": 1
          },
          "image_path": {
            "type": "string",
            "minLength": 1
          },
          "prompt_file": {
            "type": "string",
            "minLength": 1
          },
          "source_role": {
            "enum": [
              "template_reference",
              "template_board",
              "mock_reference"
            ]
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit",
        "ratio"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "ratio": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "detected_palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/palette_color"
      }
    },
    "typography_estimates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "estimated_font_family",
          "size_pt",
          "weight",
          "confidence"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "estimated_font_family": {
            "type": "string",
            "minLength": 1
          },
          "size_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "weight": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "layout_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows",
        "gutter",
        "baseline_step"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "gutter": {
          "type": "number",
          "minimum": 0
        },
        "baseline_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "safe_margins": {
      "$ref": "#/$defs/margins"
    },
    "component_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "footer_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "card_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "chart_frame_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "table_frame_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "image_frame_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "diagonal_panel_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "background_ornament_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_observation"
      }
    },
    "density_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "by_archetype"
      ],
      "properties": {
        "overall": {
          "enum": [
            "low",
            "medium",
            "high",
            "mixed"
          ]
        },
        "by_archetype": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "confidence_scores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/confidence"
      },
      "minProperties": 1
    },
    "extraction_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left",
        "unit"
      ],
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "palette_color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hex",
        "role",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "component_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "source_archetype_id",
        "component_type",
        "bounds",
        "visual_notes",
        "editable_spec_hint",
        "confidence"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_archetype_id": {
          "type": "string",
          "minLength": 1
        },
        "component_type": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "visual_notes": {
          "type": "string",
          "minLength": 1
        },
        "editable_spec_hint": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "source_archetype_id": {
          "type": "string"
        }
      }
    }
  }
}
