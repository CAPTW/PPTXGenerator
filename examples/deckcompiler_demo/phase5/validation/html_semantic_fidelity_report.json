    {
      "canonical_value": "Response options and trade-offs",
      "content_hash": "567bbb95ea802aed1d667dbc47e29956d64799e27becaf7ec67bd669143ab62b",
      "item_id": "title",
      "kind": "text",
      "pass": true,
      "selector": "#slide-4 > div:nth-of-type(3)",
      "slide": 4,
      "slot_id": "title"
    },
    {
      "canonical_value": "Claim origin: documentary fact",
      "content_hash": "b9b0047e90ff1fbe00da1175ea9ce6c6054b221b68243ac522f899bc2137e54d",
      "item_id": "subtitle",
      "kind": "text",
      "pass": true,
      "selector": "#slide-4 > div:nth-of-type(4)",
      "slide": 4,
      "slot_id": "subtitle"
    },
    {
      "canonical_value": "Option A adds pump-path redundancy and automated failover, giving the strongest interruption protection at the highest implementation effort.",
      "content_hash": "9988d2bd71591518d3bc1ee213e661fbedce9f73f7f00400f193d6ca1fa20715",
      "item_id": "slide-04-options-comparison-evidence-01",
      "kind": "text",
      "pass": true,
      "selector": "#slide-4 > table:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(1)",
      "slide": 4,
      "slot_id": "table"
    },
    {
      "canonical_value": "Option B increases monitoring and calibration frequency, reducing detection delay at lower effort but leaving pump-path exposure unchanged.",
      "content_hash": "9064f1e51ae0a83d5fae270930bf1ceebd4d2b59f766023f0a93fd6d72a8d4f1",
      "item_id": "slide-04-options-comparison-evidence-02",
      "kind": "text",
      "pass": true,
      "selector": "#slide-4 > table:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(1)",
      "slide": 4,
      "slot_id": "table"
    },
    {
      "canonical_value": "Prefer an option that protects thermal margin, preserves maintainability, and can be verified through staged commissioning.",
      "content_hash": "8b7d58c35eb398b4d590534db51b20e81c097b68338296cf31f92e2e3041b0f8",
      "item_id": "slide-04-options-comparison-evidence-03",
      "kind": "text",
      "pass": true,
      "selector": "#slide-4 > table:nth-of-type(1) > tr:nth-of-type(3) > td:nth-of-type(1)",
      "slide": 4,
      "slot_id": "table"
    },
    {
      "canonical_value": "The synthetic normal supply-temperature target is 27 C with an allowed steady-state band of plus or minus 1 C.",
      "content_hash": "2096d5daeeec19d961cfdc6436fa3c9cbc70e9a919aa959bbebc5592a3dcf62d",
      "item_id": "slide-04-options-comparison-evidence-04",
      "kind": "text",
      "pass": true,
