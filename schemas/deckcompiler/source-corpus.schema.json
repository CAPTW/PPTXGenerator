{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/source-corpus.schema.json",
  "title": "DeckCompiler Source Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "corpus_id", "sources", "normalized_segments"],
  "properties": {
    "schema_name": {"const": "source_corpus"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {
      "allOf": [
        {"$ref": "artifact-envelope.schema.json"},
        {"properties": {"artifact_type": {"const": "source_corpus"}}}
      ]
    },
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{20}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "source-item.schema.json"}
    },
    "normalized_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "source_id", "source_locator", "canonical_text", "language", "content_sha256"],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^seg_[0-9a-f]{20}$"},
          "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"},
          "source_locator": {"$ref": "source-locator.schema.json"},
          "canonical_text": {"type": "string", "minLength": 1},
          "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
