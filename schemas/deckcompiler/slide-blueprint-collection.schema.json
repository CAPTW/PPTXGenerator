{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/slide-blueprint-collection.schema.json",
  "title": "DeckCompiler Slide Blueprint Collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "collection_id", "slides", "evidence_bindings"],
  "properties": {
    "schema_name": {"const": "slide_blueprint_collection"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {
      "allOf": [
        {"$ref": "artifact-envelope.schema.json"},
        {"properties": {"artifact_type": {"const": "slide_blueprint_collection"}}}
      ]
    },
    "collection_id": {"type": "string", "pattern": "^blueprints_[0-9a-f]{20}$"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://presentation-agent.local/schemas/slide_blueprint.schema.json"}
    },
    "evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "evidence_ids", "allocation_role"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^ev_[0-9a-f]{20}$"},
            "uniqueItems": true
          },
          "allocation_role": {"enum": ["primary", "supporting", "citation_only"]}
        }
      }
    }
  }
}
