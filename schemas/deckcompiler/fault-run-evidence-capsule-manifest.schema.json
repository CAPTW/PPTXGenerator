{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/fault-run-evidence-capsule-manifest.schema.json",
  "title": "DeckCompiler fault-run evidence capsule manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "capsule_id",
    "run_id",
    "input_bundles",
    "source_commit",
    "fault_state",
    "handoff",
    "crop_artifact_records",
    "per_slide_crop_plan_records",
    "reconstruction_output_records",
    "pptx_sha256",
    "html_sha256",
    "powerpoint_render_records",
    "pptx_raster_evidence_records",
    "html_screenshot_records",
    "html_screenshot_evidence_records",
    "objective_qa_evidence_records",
    "objective_evidence",
    "reconstruction_score_record",
    "official_final_gate_record",
    "composite_qa_record",
    "prerequisite_graph",
    "prerequisite_statuses",
    "missing_artifacts",
    "stale_artifacts",
    "hash_mismatches",
    "missing_artifact_count",
    "stale_artifact_count",
    "hash_mismatch_count",
    "created_at",
    "timezone",
    "capsule_status",
    "manifest_hash"
  ],
  "properties": {
    "schema_name": {"const": "fault_run_evidence_capsule_manifest"},
    "schema_version": {"const": "1.0.0"},
    "capsule_id": {"type": "string", "pattern": "^capsule_[0-9a-f]{20}$"},
    "run_id": {"type": "string", "minLength": 1},
    "input_bundles": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fault_state": {"enum": ["baseline", "faulty", "repaired"]},
    "handoff": {"type": "object"},
    "crop_artifact_records": {"type": "array", "items": {"$ref": "#/$defs/artifactRecord"}},
    "per_slide_crop_plan_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/artifactRecord"}},
    "reconstruction_output_records": {"type": "array", "items": {"type": "object"}},
    "pptx_sha256": {"$ref": "#/$defs/hashOrEmpty"},
    "html_sha256": {"$ref": "#/$defs/hashOrEmpty"},
    "powerpoint_render_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/artifactRecord"}},
    "pptx_raster_evidence_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/artifactRecord"}},
    "html_screenshot_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/artifactRecord"}},
    "html_screenshot_evidence_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/artifactRecord"}},
    "objective_qa_evidence_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/artifactRecord"}},
    "objective_evidence": {"type": "object"},
    "reconstruction_score_record": {"type": "object"},
    "official_final_gate_record": {"type": "object"},
    "composite_qa_record": {"type": "object"},
    "prerequisite_graph": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
      }
    },
    "prerequisite_statuses": {"type": "object"},
    "missing_artifacts": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "stale_artifacts": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "hash_mismatches": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "missing_artifact_count": {"type": "integer", "minimum": 0},
    "stale_artifact_count": {"type": "integer", "minimum": 0},
    "hash_mismatch_count": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "minLength": 1},
    "timezone": {"const": "Asia/Seoul"},
    "capsule_status": {"enum": ["INCOMPLETE", "EVIDENCE_VALID", "FINAL_GATE_VALID", "COMPOSITE_QA_COMPLETE", "BLOCKED"]},
    "manifest_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashOrEmpty": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "artifactRecord": {
      "type": "object",
      "required": ["artifact_type", "path", "sha256", "size_bytes"],
      "properties": {
        "artifact_type": {"type": "string"},
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}
    }
  }
}
