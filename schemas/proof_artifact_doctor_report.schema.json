    },
    "pipeline_state_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pipeline State Path"
    },
    "fingerprint_key": {
      "default": "proof_unit_registry",
      "title": "Fingerprint Key",
      "type": "string"
    },
    "fingerprint_aliases": {
      "items": {
        "type": "string"
