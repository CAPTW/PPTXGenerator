{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/visual-target-manifest.schema.json",
  "title": "DeckCompiler Visual Target Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "manifest_id", "offline_regression_only", "targets"],
  "properties": {
    "schema_name": {"const": "visual_target_manifest"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {
      "allOf": [
        {"$ref": "artifact-envelope.schema.json"},
        {"properties": {"artifact_type": {"const": "visual_target_manifest"}}}
      ]
    },
    "manifest_id": {"type": "string", "pattern": "^targets_[0-9a-f]{20}$"},
    "offline_regression_only": {"type": "boolean"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "visual_target_id",
          "slide_id",
          "path",
          "media_type",
          "width",
          "height",
          "aspect_ratio",
          "sha256",
          "visual_authority",
          "semantic_authority",
          "final_slide_surface_allowed",
          "generation"
        ],
        "properties": {
          "visual_target_id": {"type": "string", "pattern": "^vt_[0-9a-f]{20}$"},
          "slide_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"enum": ["image/png", "image/jpeg"]},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "aspect_ratio": {"const": "16:9"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "visual_authority": {"const": true},
          "semantic_authority": {"const": false},
          "final_slide_surface_allowed": {"const": false},
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generation_mode",
              "release_eligible",
              "tool_identity",
              "model_identity",
              "prompt",
              "prompt_sha256",
              "reference_artifacts",
              "attempt_number",
              "selected"
            ],
            "properties": {
              "generation_mode": {"enum": ["live", "locked_fixture"]},
              "release_eligible": {"type": "boolean"},
              "tool_identity": {"type": "string", "minLength": 1},
              "model_identity": {"type": "string", "minLength": 1},
              "prompt": {"type": "string", "minLength": 1},
              "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "reference_artifacts": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "attempt_number": {"type": "integer", "minimum": 1},
              "selected": {"type": "boolean"},
              "rejection_reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
