{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/phase3-validation-report.schema.json",
  "title": "DeckCompiler Phase 3 Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "report_id", "run_id", "verdict", "determinism_ready", "deterministic_artifact_hashes", "schema_validation", "semantic_validation", "artifact_graph_validation", "checks", "phase_boundary", "warnings"],
  "properties": {
    "schema_name": {"const": "phase3_validation_report"},
    "schema_version": {"const": "1.0.0"},
    "artifact": {"allOf": [{"$ref": "artifact-envelope.schema.json"}, {"properties": {"artifact_type": {"const": "phase3_validation_report"}}}]},
    "report_id": {"type": "string", "pattern": "^phase3validation_[0-9a-f]{20}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{20}$"},
    "verdict": {"const": "GO"},
    "determinism_ready": {"const": true},
    "deterministic_artifact_hashes": {"type": "object", "minProperties": 16, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "schema_validation": {"$ref": "#/$defs/checkSummary"},
    "semantic_validation": {"$ref": "#/$defs/checkSummary"},
    "artifact_graph_validation": {"$ref": "#/$defs/checkSummary"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "phase_boundary": {"type": "object", "additionalProperties": {"const": "not_executed"}, "minProperties": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "checkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_count", "error_count"],
      "properties": {
        "status": {"const": "passed"},
        "checked_count": {"type": "integer", "minimum": 1},
        "error_count": {"const": 0}
      }
    }
  }
}
