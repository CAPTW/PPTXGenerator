{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/deckcompiler/platform-image-request.schema.json",
  "title": "Platform-managed Image Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "request_id", "prompt_id", "target_artifact_id", "artifact_type", "slide_id", "module_id", "batch_id", "selected_family", "selected_layout", "visual_dna_reference", "design_system_reference", "semantic_sidecar_reference", "prior_selected_visual_reference_ids", "composition_goals", "hierarchy_goals", "negative_space_target", "native_raster_intent", "text_policy", "forbidden_elements", "requested_orientation", "requested_aspect_ratio", "requested_dimensions", "fallback_normalization_policy", "prompt_text", "prompt_hash", "implementation_provenance", "execution_mode", "external_provider_id", "external_transport_used", "credential_lookup"],
  "properties": {
    "schema_name": {"const": "platform_image_request"},
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string"},
    "prompt_id": {"type": "string"},
    "target_artifact_id": {"type": "string"},
    "artifact_type": {"enum": ["design_board", "module_anchor", "batch_template_reference", "slide_visual_target"]},
    "slide_id": {"type": ["string", "null"]},
    "module_id": {"type": ["string", "null"]},
    "batch_id": {"type": ["string", "null"]},
    "selected_family": {"type": ["string", "null"]},
    "selected_layout": {"type": ["string", "null"]},
    "visual_dna_reference": {"type": "object"},
    "design_system_reference": {"type": "object"},
    "semantic_sidecar_reference": {"type": ["object", "null"]},
    "prior_selected_visual_reference_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "composition_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hierarchy_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_space_target": {"type": "string", "minLength": 1},
    "native_raster_intent": {"type": "object"},
    "text_policy": {"type": "object"},
    "forbidden_elements": {"type": "array", "minItems": 5, "items": {"type": "string"}, "uniqueItems": true},
    "requested_orientation": {"const": "landscape"},
    "requested_aspect_ratio": {"const": "16:9"},
    "requested_dimensions": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"const": 2048}, "height": {"const": 1152}}
    },
    "fallback_normalization_policy": {"type": "object"},
    "prompt_text": {"type": "string", "minLength": 40},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_provenance": {"const": "build_week_new"},
    "execution_mode": {"const": "platform_managed_tool"},
    "external_provider_id": {"type": "null"},
    "external_transport_used": {"const": false},
    "credential_lookup": {"const": false}
  }
}
