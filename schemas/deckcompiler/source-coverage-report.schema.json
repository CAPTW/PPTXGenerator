{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/source-coverage-report.schema.json",
  "title": "DeckCompiler Phase 3 Source Coverage Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "report_id", "source_count", "documentary_source_count", "no_silent_omission", "source_gaps", "evidence_type_counts", "documentary_fact_count", "source_contributions"],
  "properties": {
    "schema_name": {"const": "source_coverage_report"},
    "schema_version": {"const": "1.0.0"},
    "artifact": {
      "allOf": [
        {"$ref": "artifact-envelope.schema.json"},
        {"properties": {"artifact_type": {"const": "source_coverage_report"}}}
      ]
    },
    "report_id": {"type": "string", "pattern": "^coverage_[0-9a-f]{20}$"},
    "source_count": {"type": "integer", "minimum": 1},
    "documentary_source_count": {"type": "integer", "minimum": 0},
    "no_silent_omission": {"const": true},
    "source_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "documentary_fact_count": {"type": "integer", "minimum": 0},
    "source_contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "evidence_count", "documentary_fact_count"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{20}$"},
          "source_type": {"enum": ["user_prompt", "structured_brief", "pdf", "image"]},
          "evidence_count": {"type": "integer", "minimum": 0},
          "documentary_fact_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
