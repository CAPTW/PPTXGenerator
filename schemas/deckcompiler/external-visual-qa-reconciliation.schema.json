{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/external-visual-qa-reconciliation.schema.json",
  "title": "DeckCompiler external visual QA reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "source_output_inventory", "source_summary_sha256",
    "source_results_report_hash", "source_output_version", "canonical_output_sha256",
    "current_pptx_sha256", "current_html_sha256", "external_counts", "reported_counts",
    "parsed_counts", "mapped_counts", "covered_counts", "reported_nonpass_count",
    "mapped_nonpass_covered_count", "mapped_coverage_ratio", "canonical_finding_count",
    "external_finding_count", "findings", "resolution_category_counts", "resolved_covered_count",
    "unresolved_covered_count", "unresolved_external_finding_count", "repaired_covered_count",
    "accepted_limitation_covered_count", "unsupported_count", "duplicate_count",
    "unsupported_informational_classification_count", "conservation_checks", "errors", "warnings",
    "created_at", "timezone", "status", "report_hash"
  ],
  "properties": {
    "schema_name": {"const": "external_visual_qa_reconciliation"},
    "schema_version": {"const": "1.0.0"},
    "source_output_inventory": {"type": ["string", "null"]},
    "source_summary_sha256": {"$ref": "#/$defs/hash"},
    "source_results_report_hash": {"$ref": "#/$defs/hash"},
    "source_output_version": {"type": "string", "minLength": 1},
    "canonical_output_sha256": {"$ref": "#/$defs/hash"},
    "current_pptx_sha256": {"$ref": "#/$defs/hash"},
    "current_html_sha256": {"$ref": "#/$defs/hash"},
    "external_counts": {"type": "object"},
    "reported_counts": {"type": "object"},
    "parsed_counts": {"type": "object"},
    "mapped_counts": {"type": "object"},
    "covered_counts": {"type": "object"},
    "reported_nonpass_count": {"type": "integer", "minimum": 0},
    "mapped_nonpass_covered_count": {"type": "integer", "minimum": 0},
    "mapped_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "canonical_finding_count": {"type": "integer", "minimum": 0},
    "external_finding_count": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id", "source_result_ids", "covered_result_count", "source_tool", "source_command",
          "source_report_hash", "source_granularity", "source_slide_id", "source_rule_id", "source_status",
          "source_severity", "source_metric", "source_actual", "source_threshold", "source_message",
          "canonical_rule_id", "canonical_category", "canonical_severity", "current_pptx_sha256",
          "current_html_sha256", "current_render_screenshot_evidence_hashes", "resolution_category",
          "resolution_evidence", "decision_log_id", "release_blocking", "final_status", "finding_hash"
        ],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "covered_result_count": {"type": "integer", "minimum": 1},
          "source_tool": {"type": "string"},
          "source_command": {"type": "array", "items": {"type": "string"}},
          "source_report_hash": {"$ref": "#/$defs/hash"},
          "source_granularity": {"type": "string"},
          "source_slide_id": {"type": ["string", "null"]},
          "source_rule_id": {"type": "string"},
          "source_status": {"enum": ["fail", "needs_polish", "missing"]},
          "source_severity": {"enum": ["blocking", "noticeable", "minor", "pass"]},
          "source_metric": {}, "source_actual": {}, "source_threshold": {},
          "source_message": {"type": ["string", "null"]},
          "canonical_rule_id": {"type": "string"},
          "canonical_category": {"type": "string"},
          "canonical_severity": {"type": "string"},
          "current_pptx_sha256": {"$ref": "#/$defs/hash"},
          "current_html_sha256": {"$ref": "#/$defs/hash"},
          "current_render_screenshot_evidence_hashes": {"type": "object"},
          "resolution_category": {"enum": ["RESOLVED_FALSE_POSITIVE", "RESOLVED_METRIC_DELTA", "REPAIRED", "ACCEPTED_LIMITATION", "UNRESOLVED_BLOCKING"]},
          "resolution_evidence": {"type": "object"},
          "decision_log_id": {"type": ["string", "null"]},
          "release_blocking": {"type": "boolean"},
          "final_status": {"enum": ["RESOLVED", "NEEDS_REPAIR", "UNRESOLVED_BLOCKING"]},
          "finding_hash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "resolution_category_counts": {"type": "object"},
    "resolved_covered_count": {"type": "integer", "minimum": 0},
    "unresolved_covered_count": {"type": "integer", "minimum": 0},
    "unresolved_external_finding_count": {"type": "integer", "minimum": 0},
    "repaired_covered_count": {"type": "integer", "minimum": 0},
    "accepted_limitation_covered_count": {"type": "integer", "minimum": 0},
    "unsupported_count": {"type": "integer", "minimum": 0},
    "duplicate_count": {"type": "integer", "minimum": 0},
    "unsupported_informational_classification_count": {"type": "integer", "minimum": 0},
    "conservation_checks": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1},
    "timezone": {"const": "Asia/Seoul"},
    "status": {"enum": ["PASS", "NEEDS_REPAIR", "BLOCKED"]},
    "report_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
