{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/phase3-artifact-graph.schema.json",
  "title": "DeckCompiler Phase 3 Artifact Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact", "graph_id", "run_id", "nodes", "edges", "root_artifact_ids", "orphan_artifact_ids", "validation_status"],
  "properties": {
    "schema_name": {"const": "phase3_artifact_graph"},
    "schema_version": {"const": "1.0.0"},
    "artifact": {"allOf": [{"$ref": "artifact-envelope.schema.json"}, {"properties": {"artifact_type": {"const": "artifact_graph"}}}]},
    "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{20}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{20}$"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
    "root_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^art_[0-9a-f]{20}$"}, "uniqueItems": true},
    "orphan_artifact_ids": {"type": "array", "maxItems": 0},
    "validation_status": {"const": "valid"}
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "schema_name", "path", "semantic_content_sha256", "provenance_mode"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{20}$"},
        "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "schema_name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^[^/\\\\]+\\.json$"},
        "semantic_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance_mode": {"enum": ["embedded_envelope", "manifest_reference"]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation"],
      "properties": {
        "from": {"type": "string", "pattern": "^art_[0-9a-f]{20}$"},
        "to": {"type": "string", "pattern": "^art_[0-9a-f]{20}$"},
        "relation": {"enum": ["provenance_input", "logical_input"]}
      }
    }
  }
}
