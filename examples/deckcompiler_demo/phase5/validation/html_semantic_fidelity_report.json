    {
      "canonical_value": "System and operating process",
      "content_hash": "4a7c5e7feac6e84649477c6c41c07d7c3d7db9a5859f38ed464db24f1bdc41a9",
      "item_id": "title",
      "kind": "text",
      "pass": true,
      "selector": "#slide-2 > div:nth-of-type(3)",
      "slide": 2,
      "slot_id": "title"
    },
    {
      "canonical_value": "Claim origin: documentary fact",
      "content_hash": "b9b0047e90ff1fbe00da1175ea9ce6c6054b221b68243ac522f899bc2137e54d",
      "item_id": "subtitle",
      "kind": "text",
      "pass": true,
      "selector": "#slide-2 > div:nth-of-type(4)",
      "slide": 2,
      "slot_id": "subtitle"
    },
    {
      "canonical_value": "Heat rejection is the transfer of collected thermal energy from the facility loop to an external sink without mixing the two fluids.",
      "content_hash": "8bb218c91ee3bbda0e15c3d5499b3b7cf318891afc49de9474e1db30235e14ba",
      "item_id": "slide-02-system-process-evidence-01",
      "kind": "text",
      "pass": true,
      "selector": "#slide-2 > div:nth-of-type(20)",
      "slide": 2,
      "slot_id": "process"
    },
    {
      "canonical_value": "The primary cooling loop is the closed fluid path that carries heat from compute cold plates to a facility heat exchanger.",
      "content_hash": "3adcde4ce319345ef6e4c20b7b7ef3e939a60ca69506396181b08e45c057112d",
      "item_id": "slide-02-system-process-evidence-02",
      "kind": "text",
      "pass": true,
      "selector": "#slide-2 > div:nth-of-type(28)",
      "slide": 2,
      "slot_id": "process"
    },
    {
      "canonical_value": "Temperature, flow, and differential-pressure sensors feed a local controller that adjusts pump speed and valve position every control interval.",
      "content_hash": "9343b262c7a3f7da07fd7694c7694593ecddf7386cb2720a766ff078dc181b74",
      "item_id": "slide-02-system-process-evidence-03",
      "kind": "text",
      "pass": true,
      "selector": "#slide-2 > div:nth-of-type(36)",
      "slide": 2,
      "slot_id": "process"
    },
    {
      "canonical_value": "Stage 1 moves coolant through cold plates where server heat enters the primary loop.",
      "content_hash": "34e2fb098ff0ab050d80a8bcf9b6218d3099eb72e0478a1743bc0047b878bc8d",
      "item_id": "slide-02-system-process-evidence-04",
