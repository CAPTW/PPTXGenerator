{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/deck_assembly_plan.schema.json",
  "title": "DeckAssemblyPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deck_id",
    "selected_template_pack",
    "slide_layout_bindings",
    "missing_slot_warnings",
    "overflow_warnings",
    "render_warnings"
  ],
  "properties": {
    "schema_name": {
      "const": "deck_assembly_plan"
    },
    "schema_version": {
      "type": "string"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_template_pack": {
      "type": "string",
      "minLength": 1
    },
    "deck_scale": {
      "enum": [
        "small",
        "medium",
        "large",
        "very_large"
      ]
    },
    "selected_tone_variant": {
      "enum": [
        "academic",
        "professional",
        "creative"
      ]
    },
    "source_slide_blueprint_path": {
      "type": "string"
    },
    "template_spec_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "selection",
        "warnings"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "enum": [
            "base",
            "final",
            "explicit",
            "in_memory"
          ]
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "production_plan_used": {
      "type": "boolean"
    },
    "production_plan_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout_family_plan_path": {
          "type": "string"
        },
        "deck_scale_usage_plan_path": {
          "type": "string"
        },
        "visual_fidelity_targets_path": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "layout_family_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "layout_repetition_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "visual_fidelity_target_compliance": {
      "type": "object",
      "additionalProperties": true
    },
    "slide_layout_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "layout_id",
          "selected_layout_id",
          "slot_bindings"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "minLength": 1
          },
          "slide_type": {
            "type": "string"
          },
          "layout_id": {
            "type": "string",
            "minLength": 1
          },
          "selected_layout_id": {
            "type": "string",
            "minLength": 1
          },
          "layout_family_id": {
            "type": "string"
          },
          "section_rhythm_role": {
            "type": "string"
          },
          "component_density": {
            "type": "string"
          },
          "ornament_density": {
            "type": "string"
          },
          "fidelity_targets_applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeated_layout_warning": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "layout_id": {
                "type": "string"
              },
              "slide_id": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "layout_use_count": {
                "type": "integer",
                "minimum": 0
              },
              "family_use_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "production_plan_used": {
            "type": "boolean"
          },
          "selection_reason": {
            "type": "string"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "selected_tone_variant": {
            "enum": [
              "academic",
              "professional",
              "creative"
            ]
          },
          "deck_scale": {
            "enum": [
              "small",
              "medium",
              "large",
              "very_large"
            ]
          },
          "fallback_used": {
            "type": "boolean"
          },
          "fallback_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_overflow_warnings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/warning"
            }
          },
          "image_policy": {
            "type": [
              "string",
              "object"
            ]
          },
          "render_priority": {
            "type": "integer",
            "minimum": 1
          },
          "slide_character": {
            "type": "string"
          },
          "content_needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slot_bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "component_bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/warning"
            }
          }
        }
      }
    },
    "missing_slot_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "overflow_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "render_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "slide_id": {
          "type": "string"
        },
        "layout_id": {
          "type": "string"
        },
        "slot_id": {
          "type": "string"
        },
        "template_spec_path": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "layout_use_count": {
          "type": "integer",
          "minimum": 0
        },
        "family_use_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
