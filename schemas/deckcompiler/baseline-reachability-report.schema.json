{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/baseline-reachability-report.schema.json",
  "title": "DeckCompiler Phase 6.1 baseline reachability report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "source_commit",
    "prior_runtime_reused",
    "official_final_gate",
    "composite_qa",
    "render_count",
    "html_screenshot_count",
    "missing_artifact_count",
    "stale_artifact_count",
    "hash_mismatch_count",
    "external_qa_reconciliation",
    "external_output_structure",
    "external_output_version",
    "external_reported_counts",
    "external_source_result_count",
    "external_rule_record_count",
    "external_mapped_nonpass_covered_count",
    "external_mapped_coverage_ratio",
    "external_canonical_finding_count",
    "external_resolution_category_counts",
    "composite_dimension_status",
    "composite_acceptance",
    "status",
    "report_hash"
  ],
  "properties": {
    "schema_name": {"const": "phase6_1_baseline_reachability_report"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prior_runtime_reused": {"const": false},
    "official_final_gate": {"enum": ["PASS", "BLOCKED"]},
    "composite_qa": {"enum": ["PASS", "NEEDS_REPAIR", "BLOCKED"]},
    "render_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "html_screenshot_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "missing_artifact_count": {"type": "integer", "minimum": 0},
    "stale_artifact_count": {"type": "integer", "minimum": 0},
    "hash_mismatch_count": {"type": "integer", "minimum": 0},
    "external_qa_reconciliation": {"enum": ["PASS", "NEEDS_REPAIR", "BLOCKED"]},
    "external_output_structure": {"enum": ["rule_level_records", "slide_verdict_with_rule_records", "summary_only"]},
    "external_output_version": {"type": "string", "minLength": 1},
    "external_reported_counts": {"type": "object"},
    "external_source_result_count": {"type": "integer", "minimum": 0},
    "external_rule_record_count": {"type": "integer", "minimum": 0},
    "external_mapped_nonpass_covered_count": {"type": "integer", "minimum": 0},
    "external_mapped_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "external_canonical_finding_count": {"type": "integer", "minimum": 0},
    "external_resolution_category_counts": {"type": "object"},
    "composite_dimension_status": {"enum": ["PASS", "NEEDS_REPAIR", "BLOCKED"]},
    "composite_acceptance": {"enum": ["PASS", "NEEDS_REPAIR", "BLOCKED"]},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
