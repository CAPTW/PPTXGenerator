{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/proof_unit_registry.schema.json",
  "title": "ProofUnitRegistry",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "deck_title",
    "workflow_option",
    "workflow_policy_id",
    "workflow_contract_status",
    "registry_policy_id",
    "claim_anchor_section_id",
    "proof_section_id",
    "synthesis_anchor_section_id",
    "claim_anchor_slide_numbers",
    "synthesis_anchor_slide_numbers",
    "unit_minimum",
    "unit_count",
    "direct_evidence_unit_count",
    "synthesis_unit_count",
    "units"
  ],
  "properties": {
    "schema_name": {
      "const": "proof_unit_registry"
    },
    "schema_version": {
      "type": "string"
    },
    "deck_title": {
      "type": "string"
    },
    "workflow_option": {
      "type": "string"
    },
    "requested_workflow_option": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow_policy_id": {
      "type": "string"
    },
    "workflow_contract_status": {
      "type": "string",
      "enum": [
        "absent",
        "honored",
        "incompatible"
      ]
    },
    "registry_policy_id": {
      "type": "string"
    },
    "claim_anchor_section_id": {
      "type": "string"
    },
    "proof_section_id": {
      "type": "string"
    },
    "synthesis_anchor_section_id": {
      "type": "string"
    },
    "claim_anchor_slide_numbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "synthesis_anchor_slide_numbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "unit_minimum": {
      "type": "integer",
      "minimum": 1
    },
    "unit_count": {
      "type": "integer",
      "minimum": 0
    },
    "direct_evidence_unit_count": {
      "type": "integer",
      "minimum": 0
    },
    "synthesis_unit_count": {
      "type": "integer",
      "minimum": 0
    },
    "main_story_budget": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "main_story_actual_slide_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "appendix_actual_slide_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proofUnit"
      }
    }
  },
  "$defs": {
    "sourceMaterialRef": {
      "type": "object",
      "required": [
        "source_id",
        "label",
        "path"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "slide_range": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "proofUnit": {
      "type": "object",
      "required": [
        "unit_id",
        "workflow_option",
        "parent_section_id",
        "unit_order_index",
        "slide_number",
        "blueprint_slide_ref",
        "slide_title",
        "slide_role",
        "layout_pattern_id",
        "coverage_class",
        "evidence_origin",
        "placement",
        "claim_anchor_section_id",
        "claim_anchor_slide_number",
        "synthesis_anchor_section_id",
        "synthesis_anchor_slide_number",
        "claim_link_reason",
        "synthesis_link_reason",
        "required_evidence_assets",
        "source_material_refs",
        "workflow_policy_id",
        "provenance_reason_codes",
        "status",
        "status_reason_codes"
      ],
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "workflow_option": {
          "type": "string"
        },
        "parent_section_id": {
          "type": "string"
        },
        "unit_order_index": {
          "type": "integer",
          "minimum": 1
        },
        "slide_number": {
          "type": "integer",
          "minimum": 1
        },
        "blueprint_slide_ref": {
          "type": "string"
        },
        "slide_title": {
          "type": "string"
        },
        "slide_role": {
          "type": "string",
          "enum": [
            "evidence",
            "comparison",
            "analysis"
          ]
        },
        "layout_pattern_id": {
          "type": "string"
        },
        "coverage_class": {
          "type": "string",
          "enum": [
            "direct-evidence",
            "quantitative-evidence",
            "comparative-synthesis",
            "interpretive-synthesis"
          ]
        },
        "evidence_origin": {
          "type": "string",
          "enum": [
            "document",
            "data",
            "notes",
            "mixed",
            "generated"
          ]
        },
        "placement": {
          "type": "string",
          "enum": [
            "main-story",
            "appendix",
            "mixed"
          ]
        },
        "claim_anchor_section_id": {
          "type": "string"
        },
        "claim_anchor_slide_number": {
          "type": "integer",
          "minimum": 1
        },
        "synthesis_anchor_section_id": {
          "type": "string"
        },
        "synthesis_anchor_slide_number": {
          "type": "integer",
          "minimum": 1
        },
        "claim_link_reason": {
          "type": "string"
        },
        "synthesis_link_reason": {
          "type": "string"
        },
        "required_evidence_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_material_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceMaterialRef"
          }
        },
        "workflow_policy_id": {
          "type": "string"
        },
        "provenance_reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "incomplete",
            "invalid"
          ]
        },
        "status_reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
