{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/package-validation-report.schema.json",
  "title": "DeckCompiler Phase 7C package validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "delivery_id",
    "required_role_count",
    "missing_role_count",
    "missing_roles",
    "hash_mismatch_count",
    "secret_count",
    "credential_count",
    "private_key_count",
    "path_leak_count",
    "absolute_path_leak_count",
    "temp_path_leak_count",
    "user_path_leak_count",
    "browser_profile_count",
    "browser_binary_count",
    "private_identity_count",
    "protected_output_count",
    "external_skill_source_count",
    "oversize_file_count",
    "unexpected_executable_count",
    "unknown_binary_count",
    "font_binary_count",
    "cache_artifact_count",
    "symlink_count",
    "duplicate_artifact_id_count",
    "directory_logical_fingerprint",
    "directory_file_count",
    "directory_total_bytes",
    "archive_sha256",
    "zip_crc_status",
    "license_provenance_status",
    "license_report_hash",
    "security_audit_hash",
    "component_provenance_hash",
    "platform_generation_provenance_hash",
    "qa_policy_status",
    "full_slide_raster_count",
    "status",
    "report_hash"
  ],
  "properties": {
    "schema_name": {"const": "package_validation_report"},
    "schema_version": {"const": "1.0.0"},
    "delivery_id": {"type": "string", "minLength": 1},
    "required_role_count": {"minimum": 1, "type": "integer"},
    "missing_role_count": {"minimum": 0, "type": "integer"},
    "missing_roles": {"type": "array", "items": {"type": "string"}},
    "hash_mismatch_count": {"minimum": 0, "type": "integer"},
    "secret_count": {"minimum": 0, "type": "integer"},
    "credential_count": {"minimum": 0, "type": "integer"},
    "private_key_count": {"minimum": 0, "type": "integer"},
    "path_leak_count": {"minimum": 0, "type": "integer"},
    "absolute_path_leak_count": {"minimum": 0, "type": "integer"},
    "temp_path_leak_count": {"minimum": 0, "type": "integer"},
    "user_path_leak_count": {"minimum": 0, "type": "integer"},
    "browser_profile_count": {"minimum": 0, "type": "integer"},
    "browser_binary_count": {"minimum": 0, "type": "integer"},
    "private_identity_count": {"minimum": 0, "type": "integer"},
    "protected_output_count": {"minimum": 0, "type": "integer"},
    "external_skill_source_count": {"minimum": 0, "type": "integer"},
    "oversize_file_count": {"minimum": 0, "type": "integer"},
    "unexpected_executable_count": {"minimum": 0, "type": "integer"},
    "unknown_binary_count": {"minimum": 0, "type": "integer"},
    "font_binary_count": {"minimum": 0, "type": "integer"},
    "cache_artifact_count": {"minimum": 0, "type": "integer"},
    "symlink_count": {"minimum": 0, "type": "integer"},
    "duplicate_artifact_id_count": {"minimum": 0, "type": "integer"},
    "directory_logical_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "directory_file_count": {"minimum": 1, "type": "integer"},
    "directory_total_bytes": {"minimum": 1, "type": "integer"},
    "archive_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "zip_crc_status": {"enum": ["PASS", "NOT_APPLICABLE", "BLOCKED"]},
    "license_provenance_status": {"const": "PASS"},
    "license_report_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "security_audit_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "component_provenance_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "platform_generation_provenance_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "qa_policy_status": {"const": "PASS"},
    "full_slide_raster_count": {"const": 0},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "report_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
