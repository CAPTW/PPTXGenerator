{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-generator.local/schemas/deckcompiler/delivery-manifest.schema.json",
  "title": "DeckCompiler Phase 7C delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "delivery_id",
    "public_product",
    "internal_system",
    "release_profile_id",
    "tested_runtime_commit",
    "evidence_commit_handling",
    "config",
    "release_contract",
    "input_fixture",
    "slide_count",
    "ordered_slide_ids",
    "package_status",
    "directory_package_role",
    "archive_role",
    "package_file_count",
    "package_total_bytes",
    "inventory_record_count",
    "control_file_count",
    "self_inventory_policy",
    "package_aggregate_hash",
    "package_logical_fingerprint",
    "archive_sha256_policy",
    "phase4_authority",
    "phase5_authority",
    "phase6_proof",
    "external_skill_pin",
    "component_provenance_reference",
    "runtime_environment_reference",
    "external_prerequisite_references",
    "release_gate_reference",
    "creation_timestamp",
    "files",
    "validation_status",
    "status",
    "manifest_hash"
  ],
  "properties": {
    "schema_name": {"const": "delivery_manifest"},
    "schema_version": {"const": "1.0.0"},
    "delivery_id": {"type": "string", "minLength": 1},
    "public_product": {"const": "PPTX Generator"},
    "internal_system": {"const": "DeckCompiler"},
    "release_profile_id": {"const": "devpost_p0_frozen_visuals"},
    "tested_runtime_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "evidence_commit_handling": {"type": "string", "minLength": 1},
    "config": {"type": "object"},
    "release_contract": {"type": "object"},
    "input_fixture": {"type": "object"},
    "slide_count": {"const": 6},
    "ordered_slide_ids": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1}
    },
    "package_status": {"const": "ELIGIBLE_FOR_FRESH_CLONE_PROOF"},
    "directory_package_role": {"type": "string", "minLength": 1},
    "archive_role": {"type": "string", "minLength": 1},
    "package_file_count": {"minimum": 1, "type": "integer"},
    "package_total_bytes": {"minimum": 1, "type": "integer"},
    "inventory_record_count": {"minimum": 1, "type": "integer"},
    "control_file_count": {"const": 2},
    "self_inventory_policy": {"type": "string", "minLength": 1},
    "package_aggregate_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "package_logical_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "archive_sha256_policy": {"type": "string", "minLength": 1},
    "phase4_authority": {"type": "object"},
    "phase5_authority": {"type": "object"},
    "phase6_proof": {"type": "object"},
    "external_skill_pin": {"type": "object"},
    "component_provenance_reference": {"type": "object"},
    "runtime_environment_reference": {"type": "object"},
    "external_prerequisite_references": {"type": "array"},
    "release_gate_reference": {"type": ["object", "null"]},
    "creation_timestamp": {"format": "date-time", "type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "logical_role",
          "path",
          "byte_size",
          "sha256",
          "media_type",
          "source_artifact_id",
          "source_sha256",
          "producer_stage",
          "provenance_classification",
          "required",
          "semantic_truth_role",
          "visual_truth_role",
          "redistributable_status",
          "validation_status"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "logical_role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+$"},
          "byte_size": {"minimum": 0, "type": "integer"},
          "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "media_type": {"type": "string", "minLength": 1},
          "source_artifact_id": {"type": "string", "minLength": 1},
          "source_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "producer_stage": {"type": "string", "minLength": 1},
          "provenance_classification": {
            "enum": [
              "existing",
              "adapted",
              "build_week_new",
              "external_existing",
              "platform_generated",
              "historical_evidence",
              "protected_not_used"
            ]
          },
          "required": {"type": "boolean"},
          "semantic_truth_role": {"type": "string", "minLength": 1},
          "visual_truth_role": {"type": "string", "minLength": 1},
          "redistributable_status": {"const": "CLEARED"},
          "validation_status": {"const": "PASS"}
        }
      }
    },
    "validation_status": {"const": "PASS"},
    "status": {"const": "PASS"},
    "manifest_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
