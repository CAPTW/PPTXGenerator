{
  "$defs": {
    "ProofArtifactDoctorSurface": {
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "sunset_status": {
          "default": "unknown-or-deferred",
          "title": "Sunset Status",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "location",
        "classification",
        "rationale"
      ],
      "title": "ProofArtifactDoctorSurface",
      "type": "object"
    },
    "ProofArtifactFleetDiscoveryIssue": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "issue_code": {
          "title": "Issue Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "path",
        "issue_code",
        "detail"
      ],
      "title": "ProofArtifactFleetDiscoveryIssue",
      "type": "object"
    },
    "ProofArtifactFleetWorkspaceReport": {
      "additionalProperties": false,
      "properties": {
        "workspace_root": {
          "title": "Workspace Root",
          "type": "string"
        },
        "config_path": {
          "title": "Config Path",
          "type": "string"
        },
        "workflow_option": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Option"
        },
        "direct_shared_proof_consumer": {
          "default": false,
          "title": "Direct Shared Proof Consumer",
          "type": "boolean"
        },
        "workspace_classification": {
          "default": "not-applicable",
          "title": "Workspace Classification",
          "type": "string"
        },
        "normalization_classification": {
          "default": "not-applicable",
          "title": "Normalization Classification",
          "type": "string"
        },
        "selected_for_apply": {
          "default": false,
          "title": "Selected For Apply",
          "type": "boolean"
        },
        "migration_required": {
          "default": false,
          "title": "Migration Required",
          "type": "boolean"
        },
        "migration_status": {
          "default": "no-op",
          "title": "Migration Status",
          "type": "string"
        },
        "doctor_report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doctor Report Path"
        },
        "proof_unit_registry_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Unit Registry Path"
        },
        "proof_module_manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Module Manifest Path"
        },
        "content_plan_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Plan Path"
        },
        "pipeline_state_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline State Path"
        },
        "fingerprint_key": {
          "default": "proof_unit_registry",
          "title": "Fingerprint Key",
          "type": "string"
        },
        "fingerprint_aliases": {
          "items": {
            "type": "string"
          },
          "title": "Fingerprint Aliases",
          "type": "array"
        },
        "fingerprint_alias_read_scope": {
          "default": "pipeline-state-recollection-only",
          "title": "Fingerprint Alias Read Scope",
          "type": "string"
        },
        "fingerprint_continuity_status": {
          "default": "not-applicable",
          "title": "Fingerprint Continuity Status",
          "type": "string"
        },
        "sunset_enforcement_passed": {
          "default": false,
          "title": "Sunset Enforcement Passed",
          "type": "boolean"
        },
        "sunset_enforcement_codes": {
          "items": {
            "type": "string"
          },
          "title": "Sunset Enforcement Codes",
          "type": "array"
        },
        "would_change": {
          "items": {
            "type": "string"
          },
          "title": "Would Change",
          "type": "array"
        },
        "applied_changes": {
          "items": {
            "type": "string"
          },
          "title": "Applied Changes",
          "type": "array"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        }
      },
      "required": [
        "workspace_root",
        "config_path"
      ],
      "title": "ProofArtifactFleetWorkspaceReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "default": "",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scan_root": {
      "title": "Scan Root",
      "type": "string"
    },
    "report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Path"
    },
    "apply_requested": {
      "default": false,
      "title": "Apply Requested",
      "type": "boolean"
    },
    "dry_run": {
      "default": true,
      "title": "Dry Run",
      "type": "boolean"
    },
    "selected_classifications": {
      "items": {
        "type": "string"
      },
      "title": "Selected Classifications",
      "type": "array"
    },
    "discovered_workspace_count": {
      "default": 0,
      "title": "Discovered Workspace Count",
      "type": "integer"
    },
    "workspace_counts_by_classification": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Workspace Counts By Classification",
      "type": "object"
    },
    "workspace_counts_by_normalization_classification": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Workspace Counts By Normalization Classification",
      "type": "object"
    },
    "migration_required_count": {
      "default": 0,
      "title": "Migration Required Count",
      "type": "integer"
    },
    "migration_applied_count": {
      "default": 0,
      "title": "Migration Applied Count",
      "type": "integer"
    },
    "direct_shared_proof_consumer_count": {
      "default": 0,
      "title": "Direct Shared Proof Consumer Count",
      "type": "integer"
    },
    "fingerprint_continuity_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Fingerprint Continuity Counts",
      "type": "object"
    },
    "compat_debt_summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Compat Debt Summary",
      "type": "object"
    },
    "repo_surface_status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Repo Surface Status Counts",
      "type": "object"
    },
    "steady_state_enforcement_passed": {
      "default": false,
      "title": "Steady State Enforcement Passed",
      "type": "boolean"
    },
    "sunset_readiness_status": {
      "default": "no-workspaces-discovered",
      "title": "Sunset Readiness Status",
      "type": "string"
    },
    "sunset_blockers": {
      "items": {
        "type": "string"
      },
      "title": "Sunset Blockers",
      "type": "array"
    },
    "discovery_errors": {
      "items": {
        "$ref": "#/$defs/ProofArtifactFleetDiscoveryIssue"
      },
      "title": "Discovery Errors",
      "type": "array"
    },
    "legacy_surface_audit": {
      "items": {
        "$ref": "#/$defs/ProofArtifactDoctorSurface"
      },
      "title": "Legacy Surface Audit",
      "type": "array"
    },
    "workspaces": {
      "items": {
        "$ref": "#/$defs/ProofArtifactFleetWorkspaceReport"
      },
      "title": "Workspaces",
      "type": "array"
    }
  },
  "required": [
    "scan_root"
  ],
  "title": "ProofArtifactFleetReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/proof_artifact_fleet_report.schema.json"
}
