{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/deckcompiler/phase4c-canary-report.schema.json",
  "title": "Phase 4C Platform Canary Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "phase4c_status", "phase4_overall_status", "phase3_source_commit", "phase4b_commit", "execution_mode", "platform_tool_id", "image_model", "tool_call_id", "platform_tool_invocations", "external_provider_transport_calls", "repository_network_calls", "credential_lookups", "attempt_count", "rejection_count", "selected_design_board_count", "selected_attempt_id", "selected_sha256", "selected_dimensions", "execution_status", "visual_review_status", "phase4_bundle_status", "pngtopptx_handoff_eligible", "final_release_eligible", "pngtopptx_executed", "report_hash"],
  "properties": {
    "schema_name": {"const": "phase4c_canary_report"},
    "schema_version": {"const": "1.0.0"},
    "phase4c_status": {"const": "GO"},
    "phase4_overall_status": {"const": "NOT_YET_ELIGIBLE"},
    "phase3_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "phase4b_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_mode": {"const": "platform_managed_tool"},
    "platform_tool_id": {"const": "image_gen.imagegen"},
    "image_model": {"type": "string"},
    "tool_call_id": {"type": "string"},
    "platform_tool_invocations": {"type": "integer", "minimum": 1, "maximum": 2},
    "external_provider_transport_calls": {"const": 0},
    "repository_network_calls": {"const": 0},
    "credential_lookups": {"const": 0},
    "attempt_count": {"type": "integer", "minimum": 1, "maximum": 2},
    "rejection_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "selected_design_board_count": {"const": 1},
    "selected_attempt_id": {"type": "string"},
    "selected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_dimensions": {"type": "object"},
    "execution_status": {"const": "VERIFIED"},
    "visual_review_status": {"const": "ACCEPTED_FOR_PHASE4"},
    "phase4_bundle_status": {"const": "NOT_ELIGIBLE"},
    "pngtopptx_handoff_eligible": {"const": false},
    "final_release_eligible": {"const": false},
    "pngtopptx_executed": {"const": false},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
