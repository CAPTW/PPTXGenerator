{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/editable_template_spec_patch.schema.json",
  "title": "EditableTemplateSpecPatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch_id",
    "base_design_id",
    "source_artifact",
    "patch_policy",
    "safe_patches",
    "clamp_report",
    "safety_warnings",
    "ignored_unsafe_attempts"
  ],
  "properties": {
    "schema_name": {
      "const": "editable_template_spec_patch"
    },
    "schema_version": {
      "type": "string"
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "base_design_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extracted_design_system_path",
        "editable_template_spec_path",
        "design_brief_path"
      ],
      "properties": {
        "extracted_design_system_path": {
          "type": "string",
          "minLength": 1
        },
        "editable_template_spec_path": {
          "type": "string",
          "minLength": 1
        },
        "design_brief_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "patch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed_fields",
        "forbidden_fields"
      ],
      "properties": {
        "mode": {
          "const": "safe_patch_only"
        },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "tokens.colors",
              "tokens.typography",
              "tokens.spacing",
              "components.default_tokens",
              "layouts.density",
              "footer_style",
              "card_style",
              "background_ornament_style"
            ]
          },
          "uniqueItems": true
        },
        "forbidden_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "design_id",
              "canvas",
              "asset_policy",
              "render_policy",
              "layout_id",
              "layout.archetype_id",
              "layout.slide_type",
              "layout.slots",
              "slot_definitions",
              "primitives",
              "components.editable",
              "full_slide_raster"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "safe_patches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "component_style_variants",
        "layout_density_hints",
        "footer_style_refinements",
        "card_style",
        "background_ornament_style"
      ],
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colors",
            "typography",
            "spacing"
          ],
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            "typography": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "$ref": "#/$defs/type_patch"
                },
                "body": {
                  "$ref": "#/$defs/type_patch"
                },
                "footer": {
                  "$ref": "#/$defs/type_patch"
                }
              }
            },
            "spacing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "card_padding": {
                  "type": "number",
                  "minimum": 0.08,
                  "maximum": 0.4
                },
                "safe_margin": {
                  "type": "number",
                  "minimum": 0.35,
                  "maximum": 0.8
                }
              }
            }
          }
        },
        "component_style_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "variant_id",
              "style"
            ],
            "properties": {
              "component_id": {
                "type": "string",
                "minLength": 1
              },
              "variant_id": {
                "type": "string",
                "minLength": 1
              },
              "style": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        "layout_density_hints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layout_id",
              "archetype_id",
              "density"
            ],
            "properties": {
              "layout_id": {
                "type": "string",
                "minLength": 1
              },
              "archetype_id": {
                "type": "string",
                "minLength": 1
              },
              "density": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "footer_style_refinements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule_weight": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 1.5
            },
            "text_color_token": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "card_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0.06,
              "maximum": 0.28
            },
            "border_weight": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.8
            },
            "padding": {
              "type": "number",
              "minimum": 0.08,
              "maximum": 0.4
            }
          }
        },
        "background_ornament_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "subtle_grid",
                "thin_rules",
                "minimal"
              ]
            },
            "line_weight": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 1.2
            },
            "color_token": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "clamp_report": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clamp"
      }
    },
    "safety_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "ignored_unsafe_attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "type_patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "input",
        "output",
        "min",
        "max"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "field": {
          "type": "string"
        }
      }
    }
  }
}
