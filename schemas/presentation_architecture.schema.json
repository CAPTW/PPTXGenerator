{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-agent.local/schemas/presentation_architecture.schema.json",
  "title": "PresentationArchitecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "architecture_id",
    "deck_id",
    "deck_title",
    "objective",
    "modules",
    "slides",
    "evidence_registry",
    "policies"
  ],
  "properties": {
    "schema_name": {"const": "presentation_architecture"},
    "schema_version": {"type": "string", "minLength": 1},
    "architecture_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "deck_title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "source_plan_path": {"type": ["string", "null"]},
    "source_blueprint_path": {"type": ["string", "null"]},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    },
    "evidence_registry": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_editability",
        "image_generation_scope",
        "allow_full_slide_raster",
        "slot_binding_required",
        "batching_is_overlay"
      ],
      "properties": {
        "preserve_editability": {"const": true},
        "image_generation_scope": {"const": "template_references_only"},
        "allow_full_slide_raster": {"const": false},
        "slot_binding_required": {"const": true},
        "batching_is_overlay": {"const": true}
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "section_id",
        "title",
        "objective",
        "narrative_role",
        "slide_ids",
        "evidence_ids",
        "batches"
      ],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "narrative_role": {"type": "string", "minLength": 1},
        "slide_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/batch"}
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "order", "slide_ids", "continuity_anchor"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "slide_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "continuity_anchor": {"type": "string", "minLength": 1}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_id",
        "order",
        "module_id",
        "batch_id",
        "section_id",
        "slide_type",
        "title",
        "content_density",
        "required_slots",
        "semantic_intent",
        "evidence_ids",
        "source_bindings"
      ],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "module_id": {"type": "string", "minLength": 1},
        "batch_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "slide_type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "content_density": {"enum": ["low", "medium", "high"]},
        "required_slots": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "semantic_intent": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceBinding"}
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "slot_id", "label"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "slot_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "label", "slide_ids"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["citation", "chart_data", "table_data", "source_asset"]},
        "label": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "slide_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
